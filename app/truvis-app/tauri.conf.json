{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Truvis Editor",
  "version": "0.1.0",
  "identifier": "dev.truvis.editor",
  "build": {
    "frontendDist": "../editor/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Truvis Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#eef3f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/DruvisIII.ico",
      "../../assets/resources/DruvisIII.png"
    ]
  }
}
