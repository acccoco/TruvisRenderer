#include "api/common/mod.slangi"

/// selection outline pass 的 shader-visible ABI。
///
/// 这里的结构会进入 Vulkan push constant range，并通过 `truvis-shader-binding`
/// 生成 Rust 镜像；字段顺序和 padding 必须按 shader ABI 规则显式维护。
namespace selection_outline
{

/// mask pass 每次 draw 更新的最小 push constant。
///
/// frame data 与 GPU scene 通过全局 set 2 读取，避免把 UBO 当成 buffer device address
/// 传入 shader；这里仅保留 draw-local 的稳定 instance slot 与 submesh index。
struct MaskPushConstant
{
    uint instance_idx;
    uint submesh_idx;
    /// 保持 push constant size 为 16 字节倍数，便于 pipeline range 与增量更新稳定。
    uint _padding_0;
    uint _padding_1;
};

/// composite pass 的全屏采样参数。
///
/// `target_size` 位于 8 字节边界，`color` 位于 16 字节边界；末尾 padding
/// 明确补齐到 48 字节，避免 Slang / SPIR-V 与 Rust 侧对 `float3` padding 产生分歧。
struct CompositePushConstant
{
    bindless::SrvHandle mask_texture;
    bindless::ESamplerType sampler_type;
    float2 target_size;
    float4 color;
    float radius_px;
    float _padding_0;
    float2 _padding_1;
};

};
