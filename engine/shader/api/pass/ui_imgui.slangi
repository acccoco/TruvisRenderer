#include "api/common/mod.slangi"

namespace ui_imgui
{

/// GUI pass-local descriptor set。当前 draw command 的 texture 在 draw 前直接写入。
#define UI_IMGUI_SET_NUM GLOBAL_SETS_COUNT

#ifdef __SLANG__
[[vk::binding(0, UI_IMGUI_SET_NUM)]]
Texture2D<float4> texture;
#endif

/// ImGui draw call push constant。
///
/// GUI backend 会按 ImGui draw command 更新 pass-local texture descriptor 和 scissor；ortho 矩阵
/// 把 ImGui display-space 坐标变换到 Vulkan clip space。
struct PushConstant
{
    /// display-space -> clip-space 的正交投影矩阵。
    float4x4 ortho;
};
};
