/// @file mis.slangi
/// @brief 光源与 BSDF 采样共用的 MIS 权重。

#pragma once

struct Mis
{
    /// 一次 A 与一次 B 采样的 power heuristic；输入须为同一度量下有限、非负的完整 PDF。
    /// 已包含策略选择概率；两者均为零时没有可贡献的策略，权重定义为零。
    /// PBRT util/sampling.h::PowerHeuristic 的平方比值，版本与适配见 sampling 设计文档。
    static float power_heuristic(float pdf_a, float pdf_b)
    {
        const float scale = max(pdf_a, pdf_b);
        if (scale == 0.0f)
        {
            return 0.0f;
        }
        /// 公共尺度在比值中消去；至少一个归一化 PDF 为 1，无需用 epsilon 改变权重。
        const float a = pdf_a / scale;
        const float b = pdf_b / scale;
        return (a * a) / (a * a + b * b);
    }
};
