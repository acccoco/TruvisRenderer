#pragma once
#include "abi/engine/mod.slangi"
#include "lib/engine/core/common.slangi"
#include "lib/engine/core/random.slangi"
#include "lib/engine/core/sample.slangi"

/// GGX specular BRDF 评估器。
///
/// 构造时缓存 D/F/V 和常用 dot 项，避免路径采样、NEE 和 PDF 计算各自重复推导。
/// `roughness` 期望已经是 alpha/real roughness；调用方负责把艺术粗糙度平方后传入。
/// normal、view 和 h 必须为单位向量；delta 表面由调用方单独处理。
struct SpecularBrdf
{
    float3 f0;
    float roughness;
    float3 normal;
    float3 view;
    float3 h;

    float3 light;
    float vdoth;
    float ndotl;
    float ndotv;
    float ndoth;

    float D;
    float3 F;
    float V;

    /// @param f0 菲涅尔 F0
    /// @param roughness 粗糙度
    /// @param normal 法线
    /// @param view 观察方向，从物体到相机
    /// @param light 光照方向，从物体到光源
    __init(float3 f0, float roughness, float3 normal, float3 view, float3 h)
    {
        this.f0 = f0;
        this.roughness = roughness;
        this.normal = normal;
        this.view = view;
        this.h = h;

        this.light = normalize(2.f * saturate(dot(view, h)) * h - view);
        this.vdoth = saturate(dot(view, h));
        this.ndotl = saturate(dot(normal, light));
        this.ndotv = saturate(dot(normal, view));
        this.ndoth = saturate(dot(normal, h));

        this.D = this.ndf_ggx();
        this.F = this.fresnel_schlick();
        this.V = this.visibility_smith_ggx_correlated();
    }

    float3 brdf()
    {
        return this.F * this.D * this.V;
    }

    /// Trowbridge-Reitz GGX normal distribution function。
    ///
    /// 用 |N x H|² 保留小角度信息，避免 1-(NdotH)² 在低粗糙度高光处相消。
    /// 工程参考：Filament v1.77.1 surface_brdf.fs::D_GGX；模型与适配边界见 sampling 设计文档。
    float ndf_ggx()
    {
        const float3 nxh = cross(this.normal, this.h);
        const float a = ndoth * roughness;
        const float k = roughness / max(dot(nxh, nxh) + a * a, 1e-7f);
        return k * k * (1.f / M_PI);
    }

    /// Schlick Fresnel 近似，返回 RGB F 项。
    float3 fresnel_schlick()
    {
        const float f = pow(1.f - this.vdoth, 5.f);
        return f + this.f0 * (1.f - f);
    }

    /// Smith correlated visibility 项。
    float visibility_smith_ggx_correlated()
    {
        const float a2 = this.roughness * this.roughness;
        const float ggx_v = this.ndotl * sqrt(this.ndotv * this.ndotv * (1.f - a2) + a2);
        const float ggx_l = this.ndotv * sqrt(this.ndotl * this.ndotl * (1.f - a2) + a2);
        return 0.5f / max(ggx_v + ggx_l, 1e-7f);
    }

    /// 在完整半球按 D(H) * NdotH 采样半程向量；反射方向 PDF 为 D * NdotH / (4 * VdotH)。
    /// Random::rnd 返回 [0,1)，不能截断随机数区间，否则采样分布与 ggx_pdf 不一致。
    static float3 ggx_sample(inout uint rand_seed, const float roughness, const float3 normal)
    {
        float3 tangent, bitangent;
        Sample::create_local_coord(normal, tangent, bitangent);

        const float2 rand_val = float2(Random::rnd(rand_seed), Random::rnd(rand_seed));
        /// 正项相加避免 alpha² 很小时的相消；u<1 保证分母为正。
        /// sin² 单独求值，避免从接近 1 的 cos² 相减丢失小角度信息。
        const float a2 = roughness * roughness;
        const float one_minus_u = 1.0f - rand_val.x;
        const float a2_u = a2 * rand_val.x;
        const float denominator = one_minus_u + a2_u;
        const float cos_theta_h = sqrt(one_minus_u / denominator);
        const float sin_theta_h = sqrt(a2_u / denominator);
        const float phi_h = rand_val.y * M_PI * 2.0f;

        // 获取 GGX NDF 样本（即半程向量）
        return tangent * (sin_theta_h * cos(phi_h)) +
            bitangent * (sin_theta_h * sin(phi_h)) +
            normal * cos_theta_h;
    }

    float ggx_pdf()
    {
        return this.D * this.ndoth / max(4.f * this.vdoth, 1e-7f);
    }

    /// 返回 `BRDF / PDF` 中 specular 相关的化简项，保留给调试或未来路径复用。
    float3 brdf_with_pdf()
    {
        return this.F * this.V * (4.f * this.vdoth) / max(this.ndoth, 1e-7f);
    }

    float get_ndotl()
    {
        return this.ndotl;
    }
};

struct DiffuseBrdf
{

    /// Lambert BRDF。颜色项由调用方单独乘入，保证 PDF 与材质颜色解耦。
    static float3 brdf()
    {
        // TODO
        return float3(1.f, 1.f, 1.f) / M_PI;
    }

    /// cos-weighted 半球采样的 PDF
    /// @param normal 法线 表面法线
    /// @param dir 采样方向（朝外）
    /// @return PDF = cos(theta) / pi
    static float pdf(float3 normal, float3 dir)
    {
        const float cos_theta = max(dot(normal, dir), 0.f);
        return cos_theta / M_PI;
    }

    static float3 cos_sample(inout Random rand, float3 normal)
    {
        const float3 local_dir = Sample::get_cos_hemisphere_sample(rand.rng_stage);
        float3 tangent, bitangent;
        Sample::create_local_coord(normal, tangent, bitangent);
        return normalize(local_dir.x * tangent + local_dir.y * bitangent + local_dir.z * normal);
    }
};
