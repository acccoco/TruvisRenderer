#pragma once

#include "abi/engine/mod.slangi"

/// SceneAccess 是 shader 侧访问 engine::scene::GpuScene 间接表的唯一入口。
/// 全局 `engine::binding::gpu_scene` 来自 set 2；raster 与 RT 共用同一套索引规则。
///
/// 所有函数都假设 `RenderInstanceManager` 已经过 ready gate，只把 mesh/material 都 ready 的实例放入
/// active render list。shader 侧因此不做空指针或 slot 越界恢复；相关错误应在 prepare 阶段暴露。
struct SceneAccess
{
    [ForceInline]
    static engine::scene::Instance* instance(uint instance_idx)
    {
        return engine::binding::gpu_scene.all_instances + instance_idx;
    }

    [ForceInline]
    static engine::geometry::Geometry* get_geometry(uint instance_idx, uint submesh_idx)
    {
        engine::scene::Instance* inst = instance(instance_idx);
        const uint geometry_map_idx = inst.geometry_indirect_idx + submesh_idx;
        const uint geometry_idx = engine::binding::gpu_scene.instance_geometry_map[geometry_map_idx];
        return engine::binding::gpu_scene.all_geometries + geometry_idx;
    }

    [ForceInline]
    static engine::material::PbrMaterial* get_material(uint instance_idx, uint submesh_idx)
    {
        engine::scene::Instance* inst = instance(instance_idx);
        const uint material_map_idx = inst.material_indirect_idx + submesh_idx;
        const uint material_idx = engine::binding::gpu_scene.instance_material_map[material_map_idx];
        return engine::binding::gpu_scene.all_mats + material_idx;
    }
};
