#pragma once

#include "abi/engine/mod.slangi"
#include "lib/engine/core/bindless.slangi"
#include "lib/engine/scene/geometry_eval.slangi"
#include "lib/engine/scene/scene_access.slangi"

/// 材质贴图读取统一集中在这里，避免 RT、raycast、raster 各自维护透明度和 fallback 规则。
struct MaterialAccess
{
    /// 读取 base color + alpha。
    ///
    /// 有 diffuse_map 时 alpha 来自贴图；无贴图时 alpha 为 1。材质常量 alpha factor
    /// 在 `MaterialOpacity::alpha` 中统一相乘，避免 base color 采样路径重复处理透明语义。
    static float4 base_color_rgba(engine::material::PbrMaterial* mat, float2 uv)
    {
        if (BindlessSrv::is_valid(mat.diffuse_map))
        {
            return BindlessSrv::sample_level(mat.diffuse_map, uv, mat.diffuse_map_sampler_type, 0.0);
        }

        return float4(mat.base_color, 1.0f);
    }

    static float3 base_color(engine::material::PbrMaterial* mat, float2 uv)
    {
        return base_color_rgba(mat, uv).xyz;
    }

    /// glTF metallic-roughness 的 G/B 是线性数据，不能按颜色贴图做 gamma 解码。
    static float2 metallic_roughness(engine::material::PbrMaterial* mat, float2 uv)
    {
        float2 factors = float2(mat.metallic, mat.roughness);
        if (BindlessSrv::is_valid(mat.metallic_roughness_map))
        {
            const float4 sample = BindlessSrv::sample_level(mat.metallic_roughness_map, uv, mat.metallic_roughness_map_sampler_type, 0.0);
            factors *= sample.bg;
        }
        return saturate(factors);
    }

    /// NEE 和直接命中使用同一自发光采样，避免灯罩被 base color 错误染色或两条路径亮度不一致。
    /// 无独立贴图时保持已有程序化材质的 radiance * base color 语义。
    static float3 emission(engine::material::PbrMaterial* mat, float2 uv)
    {
        if (BindlessSrv::is_valid(mat.emissive_map))
        {
            const float3 color = BindlessSrv::sample_level(mat.emissive_map, uv, mat.emissive_map_sampler_type, 0.0).rgb;
            const float3 linear = select(color <= 0.04045, color / 12.92, pow((color + 0.055) / 1.055, 2.4));
            return mat.emissive * linear;
        }
        return mat.emissive * base_color(mat, uv);
    }
};

struct MaterialOpacity
{
    /// 综合材质 alpha factor 与贴图 alpha 后的有效透明度。
    static float alpha(engine::material::PbrMaterial* mat, float2 uv)
    {
        return mat.alpha_factor * MaterialAccess::base_color_rgba(mat, uv).w;
    }

    /// alpha cutout 判定。
    ///
    /// realtime RT 与同步 raycast 共同使用该阈值，保证可见性和拾取结果不会因为路径不同而分歧。
    static bool is_cutout(engine::material::PbrMaterial* mat, float2 uv)
    {
        if (mat.coverage_mode != engine::material::COVERAGE_ALPHA_MASK)
        {
            return false;
        }
        return alpha(mat, uv) <= mat.alpha_cutoff;
    }

    /// 根据 RayQuery / any-hit 候选三角形身份执行同一套 alpha test。
    ///
    /// TLAS 只让 AlphaMask coverage 保留 any-hit，因此这里必须用 coverage 再做一次保护；
    /// shadow、specular motion 和同步 raycast 都通过这个 helper 解释 non-opaque candidate。
    static bool is_candidate_cutout(uint instance_id, uint geometry_id, uint primitive_id, float2 barycentrics)
    {
        engine::material::PbrMaterial* mat = SceneAccess::get_material(instance_id, geometry_id);
        engine::geometry::Geometry* geometry = SceneAccess::get_geometry(instance_id, geometry_id);
        const uint3 triangle = GeometryEval::triangle(geometry, primitive_id);
        const float2 interp_uv = GeometryEval::interp_uv(geometry, triangle, barycentrics);
        return is_cutout(mat, interp_uv);
    }
};
