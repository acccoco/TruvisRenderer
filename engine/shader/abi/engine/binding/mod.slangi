#pragma once
#include "abi/engine/frame/mod.slangi"
#include "abi/engine/scene/mod.slangi"

namespace engine
{
namespace binding
{

#ifdef __SLANG__

// set 0：静态资源。该 set 在所有复用全局 layout 的 pipeline 中保持稳定。
// sampler 不携带资源所有权，只由 bindless SRV 采样时通过 `ESamplerType` 选择。
[[vk::binding(0, 0)]]
SamplerState global_samplers[];

// set 1：由 Material / Scene 数据动态索引的 sampled image 表。
// 固定管线 image 由各 pass 的 local descriptor set 显式绑定，不进入该全局数组。
// 动态下标必须通过 NonUniformResourceIndex 包装，因为同一个 wavefront 内不同像素可能访问不同 SRV。
// 采样器来自 set 0，SRV 本身只表达 image view slot。
[[vk::binding(0, 1)]]
Texture2D<float4> bindless_srvs[];

// set 2：per-frame 数据。由 runtime 在 prepare 后冻结，render pass 只能读取这个快照。
[[vk::binding(0, 2)]]
ConstantBuffer<engine::frame::PerFrameData, ScalarDataLayout> per_frame_data;

// 当前帧 GPU scene 间接表。它是 runtime 私有 scene 同步的输出，不允许 shader 修改。
[[vk::binding(1, 2)]]
ConstantBuffer<engine::scene::GpuScene, ScalarDataLayout> gpu_scene;

#endif

/// pass-local descriptor set 从全局 set 之后开始，避免不同 pass 重复定义基础 set 编号。
static const uint GLOBAL_SETS_COUNT = 3;

}
}
