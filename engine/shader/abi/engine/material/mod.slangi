#pragma once
#include "abi/engine/bindless/mod.slangi"

namespace engine
{
namespace material
{

static const uint MATERIAL_CLASS_SURFACE = 0;
static const uint MATERIAL_CLASS_TRANSMISSION = 1;
static const uint MATERIAL_CLASS_EMISSIVE = 2;

static const uint COVERAGE_OPAQUE = 0;
static const uint COVERAGE_ALPHA_MASK = 1;

static const uint TEXTURE_BASE_COLOR = 0;
static const uint TEXTURE_METALLIC_ROUGHNESS = 1;
static const uint TEXTURE_NORMAL = 2;
static const uint TEXTURE_EMISSIVE = 3;
static const uint TEXTURE_CHANNEL_COUNT = 4;

/// 每个材质引用独立持有映射；两行 float4 明确承载仿射系数，不依赖矩阵布局。
struct MaterialTexture
{
    float4 uv_row0;
    float4 uv_row1;
    engine::bindless::SrvHandle image;
    engine::bindless::ESamplerType sampler_type;
    uint tex_coord;
    /// 保持 MaterialTexture 的 48 字节 stride 与 16 字节行对齐。
    uint _padding_0;
};

/// PBR 材质的 shader-visible 表示。
///
/// 该结构由 render-side material manager 写入稳定 slot，instance/geometry 只保存 slot 映射。
/// 贴图字段是 bindless SRV handle；无效 handle 时 shader 侧必须回退到常量材质参数。
struct PbrMaterial
{
    /// 常量基础色；与 base-color 槽采样值相乘。
    float3 base_color;
    /// 金属度，范围按资产导入结果传入，shader 侧不做额外 clamp。
    float metallic;

    /// base color alpha factor。AlphaMask 中会与 diffuse texture alpha 相乘后参与 alpha test。
    float alpha_factor;
    /// 粗糙度；RT 采样中会平方为 GGX alpha。
    float roughness;
    /// `MaterialClass` 的 GPU ABI 值；CPU class 是该字段的唯一来源。
    uint material_class;
    /// `CoverageMode` 的 GPU ABI 值；TLAS any-hit 与 shader alpha-test 都由 CPU coverage 派生。
    uint coverage_mode;

    /// Transmission 的不透明度：1 表示不透射，0 表示完全透射；非 Transmission 固定为 1。
    float opacity;
    /// Transmission 的折射率；非 Transmission 固定为 1。
    float ior;
    /// AlphaMask 的 alpha cutoff；其他 coverage 固定写 0。
    float alpha_cutoff;
    /// normalTexture.scale，与二维 UV scale 无关。
    float normal_scale;

    /// 独立发光 factor/radiance，只与 emissive 槽相乘，不乘 base color。
    float3 emissive;
    /// 使后续 MaterialTexture 数组保持 16 字节对齐。
    float _padding_0;

    MaterialTexture textures[TEXTURE_CHANNEL_COUNT];
};

}

}
