#pragma once
#include "abi/engine/mod.slangi"
namespace renderer { namespace render_passes { namespace sdr {
static const uint SET_NUM = engine::binding::GLOBAL_SETS_COUNT;
static const int SHADER_X = 8;
static const int SHADER_Y = 8;
#ifdef __SLANG__
[[vk::binding(0, SET_NUM)]] RWTexture2D<float4> src_image;
[[vk::binding(1, SET_NUM)]] RWTexture2D<float4> dst_image;
[[vk::binding(2, SET_NUM)]] RWTexture2D<float4> exposure;
[[vk::binding(3, SET_NUM)]] Texture2D<float4> agx_lut;
#endif
/// uint2 按 8 字节、矩阵行按 16 字节边界读取，整体 112 字节；host alignment 为 4。
/// 白平衡三行 xyz 与 RGB 做 dot，w 显式写零；显示参数不写入 RT payload。
struct PushConstant {
    uint2 image_size;
    uint radiance_channel;
    uint tone_mapping_mode;
    uint exposure_mode;
    uint dither;
    float manual_ev;
    float auto_compensation_ev;
    uint2 src_size;
    float contrast;
    float saturation;
    float4 white_balance_r;
    float4 white_balance_g;
    float4 white_balance_b;
    float3 tonal_gains;
    /// 补齐末尾 16 字节槽，使 push constant size 为 112 字节。
    float _padding_0;
};
}}}
