#include "abi/engine/mod.slangi"

/// 累积 Pass 的数据定义。
///
/// 这是不含降噪的 legacy temporal accumulation 路径。它只根据 `accum_frames` 做
/// `lerp(old, new, 1/(n+1))`，不判断相机或 scene 历史是否可复用；历史重置由 runtime
/// 的 `ViewAccumState` 和调用方传入的帧数共同保证。
namespace renderer
{
namespace render_passes
{
namespace post_accum
{

/// Accum pass-local descriptor set。
static const uint SET_NUM = engine::binding::GLOBAL_SETS_COUNT;

#ifdef __SLANG__
[[vk::binding(0, SET_NUM)]]
RWTexture2D<float4> single_frame_input;

[[vk::binding(1, SET_NUM)]]
RWTexture2D<float4> accum_output;
#endif

static const int SHADER_X = 8;
static const int SHADER_Y = 8;

struct PushConstant
{
    /// 当前 dispatch 有效图像尺寸；多余线程必须跳过写入。
    uint2 image_size;
    /// 累积帧数（0 表示第一帧，直接复制）
    uint accum_frames;
    uint _padding_;
};

}
}
}
