#include "abi/engine/mod.slangi"

/// resolve pass 将指定的 image 按照给定的 offset 和 size 绘制到 color attachment。
///
/// 该 pass 使用 fullscreen-like quad 走 graphics pipeline，目标 image 由 RenderGraph 作为
/// color attachment 管理；源图像通过 pass-local sampled image descriptor 采样，适合把 main view 或 debug image
/// resolve 到 swapchain / GUI viewer 区域。
namespace renderer
{
namespace render_passes
{
namespace resolve
{

/// Resolve pass-local descriptor set。
static const uint SET_NUM = engine::binding::GLOBAL_SETS_COUNT;

#ifdef __SLANG__
[[vk::binding(0, SET_NUM)]]
Texture2D<float4> src_texture;
#endif

/// Push constant 参数。
struct PushConstant
{
    /// 在 color attachment 上的偏移量（像素坐标）
    float2 offset;
    /// 绘制区域的大小（像素尺寸）
    float2 size;

    /// color attachment 的尺寸（用于归一化计算）
    float2 target_size;
    /// 显式补齐到 32 字节，保持 Rust / Slang push constant range 稳定。
    float2 _padding_0;
};

}
}
}
