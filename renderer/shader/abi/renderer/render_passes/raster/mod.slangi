#include "abi/engine/mod.slangi"

namespace renderer
{
namespace render_passes
{
namespace raster
{
/// raster pass 的 per-draw push constants。
///
/// 帧数据和 scene root 复用全局 descriptor，避免将 UBO 当作 device address buffer。
/// instance/submesh 由 CPU draw loop 按 draw call 写入，shader 复用 `SceneAccess` 的索引规则。
struct PushConstants
{
    /// 当前 draw 对应的稳定 instance slot。
    uint instance_idx;
    /// 当前 draw 对应的 instance-local submesh index。
    uint submesh_idx;
    /// 显式 padding，保持 push constant 16 字节对齐。
    uint _padding_1;
    uint _padding_2;
};

}
}
}
