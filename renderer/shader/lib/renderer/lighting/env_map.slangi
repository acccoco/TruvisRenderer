/// @file env_map.slangi
/// @brief 环境贴图采样工具
///
/// 提供方向向量到球面坐标的转换，用于天空盒和环境贴图采样。
///
/// 环境光 PDF 对外统一使用 solid angle 度量。Importance sampling 启用时，采样和
/// 查询都读取 runtime 写入的 sky distribution；资源不可用或显式 Uniform 模式下回退
/// `1 / (4π)`。Importance 表内的零亮度 texel 必须保持 PDF=0，避免把不可采样方向
/// 伪装成 uniform 概率而破坏 NEE 与 BRDF sky miss 的 MIS 权重。

#pragma once
#include "lib/engine/core/common.slangi"
#include "lib/engine/core/random.slangi"

struct EnvMap
{
    /// U 横向环绕；phi=0 指向 +Z、phi=90° 指向 +X；V=0 对应北极。
    /// 极区 y 可能已舍入到 ±1，atan2 保留水平分量中的纬度信息；直接计算
    /// 北极夹角，避免先求 latitude 再做 0.5-latitude/π 的抵消。
    static float2 dir_to_uv(const float3 dir)
    {
        const float phi = atan2(dir.x, dir.z);
        const float polar_angle = atan2(length(dir.xz), dir.y);
        return float2(phi / M_PI * 0.5f + 0.5f, polar_angle / M_PI);
    }

// ============================================================================
// 环境贴图采样（用于 NEE）
// ============================================================================

    static float uniform_pdf()
    {
        return 1.f / (4.f * M_PI);
    }

    static bool importance_enabled()
    {
        return push_const.sky_sampling_mode == renderer::render_passes::realtime_rt::SKY_SAMPLING_MODE_IMPORTANCE &&
            engine::binding::gpu_scene.sky_distribution_enabled != 0 &&
            engine::binding::gpu_scene.sky_distribution_width > 0 &&
            engine::binding::gpu_scene.sky_distribution_height > 0;
    }

    static uint distribution_texel_count()
    {
        return engine::binding::gpu_scene.sky_distribution_width * engine::binding::gpu_scene.sky_distribution_height;
    }

    static uint texel_index_from_dir(const float3 dir)
    {
        const uint width = engine::binding::gpu_scene.sky_distribution_width;
        const uint height = engine::binding::gpu_scene.sky_distribution_height;
        const float2 uv = dir_to_uv(dir);
        const float u = frac(uv.x);
        const float v = clamp(uv.y, 0.0f, 1.0f);
        const uint x = min((uint)(u * (float)width), width - 1);
        const uint y = min((uint)(v * (float)height), height - 1);
        return y * width + x;
    }

    /// 返回行内均匀 solid-angle 样本的 (水平半径, Y)，不经过 UV 的反三角往返。
    /// 极区用 q=1-cos(alpha)=2*sin²(alpha/2) 表达距最近极点的球冠面积，避免
    /// 先将 y 舍入到 ±1 再恢复半径。仅整行距极点不超过 45° 时使用球冠分支；
    /// 中部直接插值 y，避免在赤道附近相减大球冠面积。
    static float2 sample_row(const uint row, const uint height, const float random_value)
    {
        const bool north = row < height / 2;
        const uint pole_row = min(row, height - 1 - row);
        if ((pole_row + 1) * 4 <= height)
        {
            const float half_step = 0.5f * M_PI / (float)height;
            const float near_sin = sin((float)pole_row * half_step);
            const float far_sin = sin((float)(pole_row + 1) * half_step);
            const float near_q = 2.0f * near_sin * near_sin;
            const float far_q = 2.0f * far_sin * far_sin;
            const float q = north ? lerp(far_q, near_q, random_value) : lerp(near_q, far_q, random_value);
            return float2(sqrt(q * (2.0f - q)), (north ? 1.0f : -1.0f) * (1.0f - q));
        }

        const float half_step = 0.5f * M_PI / (float)height;
        const float top = sin(((float)height - 2.0f * (float)row) * half_step);
        const float bottom = sin(((float)height - 2.0f * (float)(row + 1)) * half_step);
        const float y = lerp(bottom, top, random_value);
        return float2(sqrt(max(0.0f, (1.0f - y) * (1.0f + y))), y);
    }

    static float distribution_pdf_from_index(const uint index)
    {
        const uint count = distribution_texel_count();
        if (!importance_enabled() || index >= count)
        {
            return uniform_pdf();
        }

        const engine::scene::SkyDistributionEntry entry = engine::binding::gpu_scene.sky_distribution[index];
        // distribution 已可用时，单个零亮度 texel 的概率就是 0；只有资源不可用或
        // 显式 Uniform 模式才回退 uniform sphere。负值按坏数据夹到 0，避免污染 MIS。
        return max(entry.solid_angle_pdf, 0.0f);
    }

    /// 查询给定 sky 方向的 solid-angle PDF。
    ///
    /// NEE 采样和 BRDF sky miss 都必须继续经过这个入口，避免不同路径各自维护 PDF。
    static float pdf(const float3 dir)
    {
        if (!importance_enabled())
        {
            return uniform_pdf();
        }

        return distribution_pdf_from_index(texel_index_from_dir(dir));
    }

    /// 均匀采样整球面方向。
    ///
    /// 该采样不考虑环境贴图亮度，用于显式 Uniform 模式和 importance 资源不可用时的稳定回退。
    static void sample_uniform(inout uint seed, out float3 out_dir, out float out_pdf)
    {
        const float u1 = Random::rnd(seed);
        const float u2 = Random::rnd(seed);

        const float phi = 2.f * M_PI * u1;
        const float cos_theta = 1.f - 2.f * u2;
        const float sin_theta = sqrt(max(0.f, 1.f - cos_theta * cos_theta));

        out_dir = float3(
            sin_theta * cos(phi),
            cos_theta,
            sin_theta * sin(phi)
        );
        out_pdf = uniform_pdf();
    }

    /// 按 runtime 生成的 alias table 采样 HDRI。
    ///
    /// 选中 texel 后在该 texel 覆盖的 solid angle 内均匀采样，返回该 cell 的密度。
    /// 连续域下它与 pdf(dir) 一致；浮点接缝/行列边界的舍入仍有误差，不能靠重查 PDF 修复分布。
    static void sample_importance(inout uint seed, out float3 out_dir, out float out_pdf)
    {
        if (!importance_enabled())
        {
            sample_uniform(seed, out_dir, out_pdf);
            return;
        }

        const uint width = engine::binding::gpu_scene.sky_distribution_width;
        const uint height = engine::binding::gpu_scene.sky_distribution_height;
        const uint count = distribution_texel_count();
        if (count == 0)
        {
            sample_uniform(seed, out_dir, out_pdf);
            return;
        }

        const uint column = min((uint)(Random::rnd(seed) * (float)count), count - 1);
        const engine::scene::SkyDistributionEntry alias_entry = engine::binding::gpu_scene.sky_distribution[column];
        const float alias_probability = clamp(alias_entry.alias_probability, 0.0f, 1.0f);
        uint selected = Random::rnd(seed) < alias_probability ? column : alias_entry.alias_index;
        selected = min(selected, count - 1);

        const engine::scene::SkyDistributionEntry selected_entry = engine::binding::gpu_scene.sky_distribution[selected];
        const float selected_pdf = max(selected_entry.solid_angle_pdf, 0.0f);

        const uint x = selected % width;
        const uint y = selected / width;
        const float u = ((float)x + Random::rnd(seed)) / (float)width;

        const float2 row_sample = sample_row(y, height, Random::rnd(seed));
        const float phi = (u - 0.5f) * 2.0f * M_PI;
        out_dir = float3(row_sample.x * sin(phi), row_sample.y, row_sample.x * cos(phi));
        // alias 表异常或零权重 texel 会让调用方按零 PDF 丢弃候选；这里不能回退
        // uniform，否则 sample(dir) 与 pdf(dir) 会使用两套不同概率度量。
        out_pdf = selected_pdf;
    }

    /// 按当前模式采样环境光；Importance 资源不可用时内部回退 uniform。
    static void sample(inout uint seed, out float3 out_dir, out float out_pdf)
    {
        if (push_const.sky_sampling_mode == renderer::render_passes::realtime_rt::SKY_SAMPLING_MODE_IMPORTANCE)
        {
            sample_importance(seed, out_dir, out_pdf);
            return;
        }
        sample_uniform(seed, out_dir, out_pdf);
    }
};
