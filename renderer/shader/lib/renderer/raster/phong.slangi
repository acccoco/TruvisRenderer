#pragma once

/// raster Phong pass 在 VS/PS 之间传递的插值属性。
///
/// 光栅化与 RT 从同一套顶点 UV 读取数据，材质通道在采样时应用各自的变换。
struct CoarseVertex
{
    [[vk::location(0)]]
    float3 world_pos : WORLD_POS;

    [[vk::location(1)]]
    float3 frag_normal : FRAG_NORMAL;

    [[vk::location(2)]]
    float2 uv : UV;

    [[vk::location(3)]]
    float4 tangent : TANGENT;
};
