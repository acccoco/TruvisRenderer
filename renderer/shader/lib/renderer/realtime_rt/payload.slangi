/// @file payload.slangi
/// @brief realtime RT shader 间传递的最小载荷契约。
///
/// closest-hit / miss 只负责把一次追踪事件整理成 `RtSurfaceHit`；raygen 负责基于事件推进
/// path state。这个边界避免 hit shader 夹带 BRDF / throughput / radiance 逻辑。

#pragma once
/// 共享 guard 只选择 translation unit 的 pass ABI，事件类型由 ray_payload 单独持有。
/// Offline 必须先包含自己的入口契约，阻止共享 helper 注入 Realtime push constants。
#ifndef TRUVIS_RT_PAYLOAD_SLANGI
#define TRUVIS_RT_PAYLOAD_SLANGI
#include "abi/renderer/render_passes/realtime_rt/mod.slangi"

/// Push Constants 声明（所有 RT 着色器共享）。
///
/// raygen、hit 和 miss 使用同一个 push constant block，确保 channel 参数在一次 trace 的所有 shader
/// invocation 中一致。
[[vk::push_constant]]
renderer::render_passes::realtime_rt::PushConstants push_const;

/// 路径追踪最大深度。递归深度仍由 raygen 手动推进，Vulkan pipeline recursion depth 只覆盖 shader 调用栈。
const static uint max_depth = 16;

#include "lib/renderer/ray_payload.slangi"

#endif // TRUVIS_RT_PAYLOAD_SLANGI
