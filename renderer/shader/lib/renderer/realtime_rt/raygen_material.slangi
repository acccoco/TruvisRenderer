/// @file raygen_material.slangi
/// @brief raygen path loop 使用的材质采样与 BRDF 评估。

#pragma once

#include "lib/renderer/realtime_rt/payload.slangi"
#include "lib/renderer/ray_numeric.slangi"
#include "lib/engine/core/random.slangi"
#include "lib/engine/core/sample.slangi"
#include "lib/engine/lighting/pbr.slangi"

/// 材质采样结果。
///
/// delta 路径的 `brdf_pdf` 固定为 1，不参与 MIS；非 delta 路径使用混合 BRDF PDF。
struct RtMaterialSample
{
    /// 下一跳 ray origin，已按几何法线和 float32 ULP 规则推出表面。
    float3 origin;
    /// 下一跳 ray direction，世界空间单位向量。
    float3 direction;
    /// 路径 throughput 乘子，已包含 BSDF*cos/pdf、离散分支补偿和透射 radiance 尺度。
    float3 throughput;
    /// 仅透射事件保存 n入射/n出射；路径用其倒数平方补偿 roulette，不改变实际 radiance。
    float transmission_eta;
    /// 当前表面直接产生的 emission；raygen 会乘旧 throughput 累加。
    float3 emission;
    /// true 表示材质采样已经终止路径。
    bool done;
    /// 当前采样方向对应的 BRDF PDF，供后续 sky/emissive MIS 使用。
    float brdf_pdf;

    static RtMaterialSample make_default(const RtSurfaceHit surface, float3 ray_dir)
    {
        RtMaterialSample sample;
        sample.origin = surface.position;
        sample.direction = ray_dir;
        sample.throughput = float3(1.0f);
        sample.transmission_eta = 1.0f;
        sample.emission = float3(0.0f);
        sample.done = false;
        sample.brdf_pdf = 1.0f;
        return sample;
    }
};

/// 空气与当前材质的光滑介质界面；仅为 shader 局部结果，不属于共享 ABI。
/// 材质采样和确定性 motion direction 共用方向、Fresnel 与全内反射判定。
struct RtDielectricInterface
{
    float eta;
    float reflectance;
    float3 refracted_direction;
    bool total_internal_reflection;

    static RtDielectricInterface evaluate(const RtSurfaceHit surface, const float3 ray_dir)
    {
        RtDielectricInterface result;
        const float ior = max(surface.ior, 1.0f);
        result.eta = dot(ray_dir, surface.origin_normal) > 0.0f ? ior : 1.0f / ior;
        result.reflectance = 0.0f;
        result.refracted_direction = ray_dir;
        result.total_internal_reflection = false;
        // 折射率匹配时没有界面；掠射也不能进入 Fresnel 的 0/0。
        if (ior == 1.0f)
        {
            return result;
        }

        const float cos_i = saturate(dot(-ray_dir, surface.forward_normal));
        const float sin_t_squared = result.eta * result.eta * max(0.0f, 1.0f - cos_i * cos_i);
        if (sin_t_squared >= 1.0f)
        {
            result.reflectance = 1.0f;
            result.refracted_direction = float3(0.0f);
            result.total_internal_reflection = true;
            return result;
        }

        const float cos_t = sqrt(1.0f - sin_t_squared);
        const float r_parallel = (cos_i - result.eta * cos_t) / (cos_i + result.eta * cos_t);
        const float r_perpendicular = (result.eta * cos_i - cos_t) / (result.eta * cos_i + cos_t);
        result.reflectance = saturate(0.5f * (r_parallel * r_parallel + r_perpendicular * r_perpendicular));
        result.refracted_direction = normalize(
            result.eta * ray_dir + (result.eta * cos_i - cos_t) * surface.forward_normal
        );
        return result;
    }
};

struct RtMaterialSampler
{
    static void sample_perfect_reflection(
        const RtSurfaceHit surface,
        const float3 ray_dir,
        out float3 out_dir,
        out float3 out_throughput
    )
    {
        // 简化 specular 路径使用 Schlick Fresnel 调制 throughput；它是 delta 事件，不参与 BRDF PDF 混合。
        out_dir = reflect(ray_dir, surface.forward_normal);
        const float reflectance = 0.8f;
        const float3 f0 = lerp(0.16f * reflectance * reflectance, surface.base_color, surface.metallic);
        const float cos_theta = saturate(dot(-ray_dir, surface.forward_normal));
        const float fresnel = pow(1.0f - cos_theta, 5.0f);
        out_throughput = f0 + (1.0f - f0) * fresnel;
    }

    static RtMaterialSample sample_delta_transmission(
        inout RtTracePayload payload,
        const RtSurfaceHit surface,
        const float3 ray_dir
    )
    {
        RtMaterialSample sample = RtMaterialSample::make_default(surface, ray_dir);
        const RtDielectricInterface boundary = RtDielectricInterface::evaluate(surface, ray_dir);
        const float reflection = boundary.reflectance;
        // opacity 只吸收透射能量，不把损失转给反射；颜色也只在实际透射时逐界面应用。
        const float transmission = saturate(1.0f - surface.opacity) * (1.0f - reflection);
        const float scattering = reflection + transmission;
        if (scattering <= 0.0f)
        {
            sample.throughput = float3(0.0f);
            sample.done = true;
            return sample;
        }

        // 用分支能量归一化选择概率，BSDF / P(branch) 的公共因子就是 scattering。
        // 单分支（包含全内反射）无需随机数；全内反射的 reflection=scattering=1。
        bool choose_refract = reflection == 0.0f;
        if (reflection > 0.0f && transmission > 0.0f)
        {
            choose_refract = Random::rnd(payload.random_seed) < transmission / scattering;
        }
        if (choose_refract)
        {
            sample.direction = boundary.refracted_direction;
            sample.transmission_eta = boundary.eta;
            sample.throughput = scattering * surface.base_color * (boundary.eta * boundary.eta);
        }
        else
        {
            sample.direction = reflect(ray_dir, surface.forward_normal);
            sample.throughput = float3(scattering);
        }
        sample.origin = offset_ray_origin(surface.position, surface.origin_normal, sample.direction);
        return sample;
    }

    static RtMaterialSample sample_specular(const RtSurfaceHit surface, const float3 ray_dir)
    {
        RtMaterialSample sample = RtMaterialSample::make_default(surface, ray_dir);
        sample_perfect_reflection(surface, ray_dir, sample.direction, sample.throughput);
        sample.origin = offset_ray_origin(surface.position, surface.origin_normal, sample.direction);
        return sample;
    }

    static RtMaterialSample sample_diffuse(
        inout RtTracePayload payload,
        const RtSurfaceHit surface,
        const float3 ray_dir
    )
    {
        RtMaterialSample sample = RtMaterialSample::make_default(surface, ray_dir);
        const float3 view_dir = -ray_dir;
        const float prob_diffuse = surface.roughness;
        const bool choose_diffuse = Random::rnd(payload.random_seed) < prob_diffuse;

        if (choose_diffuse)
        {
            // diffuse 分支使用 cosine hemisphere sampling，因此 PDF 为 cos(theta)/pi。
            const float3 local_dir = Sample::get_cos_hemisphere_sample(payload.random_seed);
            float3 tangent, bitangent;
            Sample::create_local_coord(surface.forward_normal, tangent, bitangent);
            sample.direction = normalize(local_dir.x * tangent + local_dir.y * bitangent + local_dir.z * surface.forward_normal);
        }
        else
        {
            // glossy 分支按 GGX NDF 采样 half vector，再反射 view direction 得到出射方向。
            const float reflectance = 0.8f;
            const float3 f0 = lerp(0.16f * reflectance * reflectance, surface.base_color, surface.metallic);
            const float real_roughness = surface.roughness * surface.roughness;
            float3 h = SpecularBrdf::ggx_sample(payload.random_seed, real_roughness, surface.forward_normal);
            sample.direction = reflect(-view_dir, h);
        }

        const float ndotl = dot(surface.forward_normal, sample.direction);
        if (ndotl <= 0.0f)
        {
            sample.throughput = float3(0.0f);
            sample.brdf_pdf = 1.0f;
            // 即使该无效方向最终只携带零 throughput，也保持下一跳起点契约，避免调试路径
            // 或后续状态变化时从几何表面内部重新发 ray。
            sample.origin = offset_ray_origin(surface.position, surface.origin_normal, sample.direction);
            return sample;
        }

        const float3 brdf_cos = eval_brdf(surface, view_dir, sample.direction);
        sample.brdf_pdf = eval_brdf_pdf(surface, view_dir, sample.direction);
        // throughput 使用混合 BRDF 的 full PDF，保证 diffuse/specular 随机分支仍是无偏估计。
        sample.throughput = brdf_cos / max(sample.brdf_pdf, 1e-7f);
        sample.origin = offset_ray_origin(surface.position, surface.origin_normal, sample.direction);
        return sample;
    }

    static RtMaterialSample sample_next(
        inout RtTracePayload payload,
        const RtSurfaceHit surface,
        const float3 ray_dir
    )
    {
        RtMaterialSample sample = RtMaterialSample::make_default(surface, ray_dir);
        if (surface.material_type == MaterialType::EMISSIVE)
        {
            sample.emission = surface.emissive;
            sample.done = true;
            return sample;
        }

        switch (surface.material_type)
        {
        case MaterialType::DELTA_TRANSMISSION:
            return sample_delta_transmission(payload, surface, ray_dir);
        case MaterialType::DELTA_SPECULAR:
            return sample_specular(surface, ray_dir);
        case MaterialType::ROUGH_TRANSMISSION:
            // v1 尚未实现 rough BTDF；这里明确走 non-delta surface fallback，避免 rough glass 被误当作 delta path。
            return sample_diffuse(payload, surface, ray_dir);
        case MaterialType::ROUGH_SURFACE:
        default:
            return sample_diffuse(payload, surface, ray_dir);
        }
    }

    /// 计算给定方向的 BRDF PDF（用于 MIS）。
    ///
    /// diffuse/specular 混合概率与 `sample_diffuse` 中的随机分支保持一致，否则 NEE 的 MIS
    /// 会低估或高估环境采样贡献。
    static float eval_brdf_pdf(const RtSurfaceHit surface, const float3 view_dir, const float3 light_dir)
    {
        if (surface.is_delta_path())
        {
            return 0.0f;
        }

        const float prob_diffuse = surface.roughness;
        const float diffuse_pdf = DiffuseBrdf::pdf(surface.forward_normal, light_dir);

        const float3 h = normalize(view_dir + light_dir);
        const float reflectance = 0.8f;
        const float3 f0 = lerp(0.16f * reflectance * reflectance, surface.base_color, surface.metallic);
        const float real_roughness = surface.roughness * surface.roughness;
        SpecularBrdf specular_brdf = SpecularBrdf(f0, real_roughness, surface.forward_normal, view_dir, h);
        const float specular_pdf = specular_brdf.ggx_pdf();

        return prob_diffuse * diffuse_pdf + (1.0f - prob_diffuse) * specular_pdf;
    }

    /// 评估 BRDF * cos(theta)，用于 NEE 直接光照贡献。
    ///
    /// 这里不乘 path throughput，也不除以 light PDF；这些权重由 direct lighting/path state 组合。
    static float3 eval_brdf(const RtSurfaceHit surface, const float3 view_dir, const float3 light_dir)
    {
        const float ndotl = max(dot(surface.forward_normal, light_dir), 0.0f);
        if (ndotl <= 0.0f)
        {
            return float3(0.0f);
        }

        const float3 diffuse_color = (1.0f - surface.metallic) * surface.base_color;
        const float3 diffuse = diffuse_color / M_PI;

        const float3 h = normalize(view_dir + light_dir);
        const float reflectance = 0.8f;
        const float3 f0 = lerp(0.16f * reflectance * reflectance, surface.base_color, surface.metallic);
        const float real_roughness = surface.roughness * surface.roughness;
        SpecularBrdf specular_brdf = SpecularBrdf(f0, real_roughness, surface.forward_normal, view_dir, h);
        const float3 specular = specular_brdf.brdf();

        return (diffuse + specular) * ndotl;
    }
};
