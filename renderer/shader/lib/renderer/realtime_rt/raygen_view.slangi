/// @file raygen_view.slangi
/// @brief raygen 的 view、depth 与 motion-vector 相关计算。

#pragma once

#include "lib/renderer/realtime_rt/payload.slangi"
#include "lib/renderer/ray_numeric.slangi"
#include "lib/renderer/realtime_rt/gbuffer.slangi"
#include "lib/engine/scene/material_access.slangi"
#include "lib/engine/scene/scene_access.slangi"

struct RtRaygenView
{
    /// 生成 primary camera ray。
    ///
    /// temporal jitter 只影响当前帧 primary ray；`engine::binding::per_frame_data.projection / prev_projection`
    /// 保持无 jitter，保证 motion vector 语义稳定为 previous_pixel - current_pixel。
    static RayDesc camera_ray(uint2 thread_id)
    {
        const float2 pixel_center = float2(thread_id) + float2(0.5f, 0.5f) + engine::binding::per_frame_data.temporal_jitter_px;
        const float2 in_uv = pixel_center / float2(DispatchRaysDimensions().xy);
        const float4 target_in_view = mul(
            engine::binding::per_frame_data.inv_projection,
            float4(in_uv.x * 2.0 - 1.0, 1.0 - in_uv.y * 2.0, 1.0, 1.0)
        );
        const float4 direction = mul(engine::binding::per_frame_data.inv_view, float4(normalize(target_in_view.xyz), 0.0));

        RayDesc ray;
        ray.Origin = engine::binding::per_frame_data.camera_pos;
        ray.Direction = direction.xyz;
        ray.TMin = RT_PRIMARY_T_MIN;
        ray.TMax = RT_TRACE_T_MAX;
        return ray;
    }

    /// DLSS SR 使用 projection 后的 device depth；不要与 GBufferB.w 中的 ray hit_t 混用。
    static float device_depth(float3 world_position)
    {
        const float4 view_position = mul(engine::binding::per_frame_data.view, float4(world_position, 1.0f));
        const float4 clip_position = mul(engine::binding::per_frame_data.projection, view_position);
        return saturate(clip_position.z / clip_position.w);
    }

    static bool is_projectable_clip(float4 clip_position)
    {
        // 负 w 位于相机背后；它与近零 w、非有限值一样没有可用的历史投影。
        return all(isfinite(clip_position)) && clip_position.w > 1e-6f;
    }

    static float2 clip_to_pixel(float4 clip_position)
    {
        // Vulkan NDC y 向上，纹理/像素坐标 y 向下，因此这里做 0.5 - ndc.y * 0.5 的翻转。
        const float2 ndc = clip_position.xy / clip_position.w;
        const float2 uv = float2(ndc.x * 0.5f + 0.5f, 0.5f - ndc.y * 0.5f);
        return uv * engine::binding::per_frame_data.resolution;
    }

    static float4 project_world_to_clip(float4 world_position, float4x4 view, float4x4 projection)
    {
        const float4 view_position = mul(view, world_position);
        return mul(projection, view_position);
    }

    /// 计算 DLSS 使用的 pixel-space 2D motion vector。
    ///
    /// 方向约定为“当前像素回溯到上一帧位置”，即 previous_pixel - current_pixel。
    static float2 motion_vector_pixels(float4 current_world_position, float4 previous_world_position)
    {
        const float4 current_clip = project_world_to_clip(
            current_world_position,
            engine::binding::per_frame_data.view,
            engine::binding::per_frame_data.projection
        );
        const float4 previous_clip = project_world_to_clip(
            previous_world_position,
            engine::binding::per_frame_data.prev_view,
            engine::binding::per_frame_data.prev_projection
        );

        if (!is_projectable_clip(current_clip) || !is_projectable_clip(previous_clip))
        {
            return float2(renderer::render_passes::realtime_rt::DLSS_MOTION_VECTOR_INVALID_VALUE);
        }

        const float2 motion = clip_to_pixel(previous_clip) - clip_to_pixel(current_clip);
        const float invalid = renderer::render_passes::realtime_rt::DLSS_MOTION_VECTOR_INVALID_VALUE;
        if (!all(isfinite(motion)) || any(abs(motion) > -invalid))
        {
            return float2(invalid);
        }
        return motion;
    }

    static float2 instance_motion_vector_pixels(uint instance_id, float3 object_position)
    {
        // 使用 object position 分别乘 current/previous model，才能同时表达相机和物体运动。
        engine::scene::Instance* instance = SceneAccess::instance(instance_id);
        const float3 current_world_position = mul(instance.model, float4(object_position, 1.0f)).xyz;
        const float3 previous_world_position = mul(instance.prev_model, float4(object_position, 1.0f)).xyz;
        return motion_vector_pixels(float4(current_world_position, 1.0f), float4(previous_world_position, 1.0f));
    }

    /// Streamline 2.14.1 RR guide：primary surface 到最近反射命中的世界距离。
    /// 确定性 shading-normal 反射是粗糙反射的近似，不包含折射或动态物体的完整历史运动。
    static float primary_specular_hit_distance(const RtSurfaceHit primary_hit, float3 primary_ray_dir)
    {
        const float far_distance = renderer::render_passes::realtime_rt::RR_FAR_HIT_DISTANCE;
        const float normal_length = length(primary_hit.forward_normal);
        const float direction_length = length(primary_ray_dir);
        if (!all(isfinite(primary_hit.position)) || !all(isfinite(primary_hit.origin_normal)) ||
            !isfinite(normal_length) || normal_length <= 1e-6f ||
            !isfinite(direction_length) || direction_length <= 1e-6f)
        {
            return far_distance;
        }
        const float3 reflected = reflect(primary_ray_dir / direction_length, primary_hit.forward_normal / normal_length);
        const float reflected_length = length(reflected);
        if (!isfinite(reflected_length) || reflected_length <= 1e-6f)
        {
            return far_distance;
        }
        const float3 reflection_dir = reflected / reflected_length;
        RayDesc specular_ray;
        specular_ray.Origin = offset_ray_origin(primary_hit.position, primary_hit.origin_normal, reflection_dir);
        specular_ray.Direction = reflection_dir;
        specular_ray.TMin = RT_PRIMARY_T_MIN;
        specular_ray.TMax = RT_TRACE_T_MAX;
        if (!all(isfinite(specular_ray.Origin)))
        {
            return far_distance;
        }

        RayQuery<RAY_FLAG_SKIP_CLOSEST_HIT_SHADER> rq;
        rq.TraceRayInline(
            renderer::render_passes::realtime_rt::rt_tlas,
            RAY_FLAG_NONE,
            0xFF,
            specular_ray
        );
        while (rq.Proceed())
        {
            if (rq.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE)
            {
                const bool cutout = MaterialOpacity::is_candidate_cutout(
                    rq.CandidateInstanceID(),
                    rq.CandidateGeometryIndex(),
                    rq.CandidatePrimitiveIndex(),
                    rq.CandidateTriangleBarycentrics()
                );
                if (!cutout)
                {
                    rq.CommitNonOpaqueTriangleHit();
                }
            }
        }

        if (rq.CommittedStatus() != COMMITTED_TRIANGLE_HIT)
        {
            return far_distance;
        }
        const float3 hit_position = specular_ray.Origin + rq.CommittedRayT() * specular_ray.Direction;
        const float hit_distance = length(hit_position - primary_hit.position);
        return isfinite(hit_distance) && hit_distance >= 0.0f ? min(hit_distance, far_distance) : far_distance;
    }

    /// 写入首次命中的 GBuffer 与 DLSS 输入。
    static void write_primary_hit_outputs(uint2 thread_id, const RtSurfaceHit surface, float specular_hit_distance)
    {
        RtGBufferData gbuffer_data = RtGBufferWriter::make_data(
            surface.position,
            surface.forward_normal,
            surface.hit_t,
            surface.base_color,
            surface.metallic,
            surface.roughness,
            surface.material_type
        );
        RtGBufferWriter::write_gbuffer_hit(thread_id, gbuffer_data);
        const float2 primary_motion_vector = instance_motion_vector_pixels(surface.instance_id, surface.object_position);
        RtGBufferWriter::write_dlss_sr_hit(thread_id, device_depth(surface.position), primary_motion_vector);
        RtGBufferWriter::write_dlss_rr_hit(thread_id, gbuffer_data, specular_hit_distance);
    }

    /// miss 像素也必须写入 DLSS 输入，避免 SR/RR 读取上一帧残留。
    static void write_primary_miss_outputs(uint2 thread_id, float3 primary_ray_dir)
    {
        RtGBufferWriter::write_gbuffer_miss(thread_id);
        // 无限远天空共用无 jitter 投影；w=0 排除 camera translation，保留旋转和 FOV 变化。
        const float4 direction = float4(primary_ray_dir, 0.0f);
        RtGBufferWriter::write_dlss_sr_miss(thread_id, motion_vector_pixels(direction, direction));
        RtGBufferWriter::write_dlss_rr_miss(thread_id);
    }
};
