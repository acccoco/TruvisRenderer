/// @file restir_di.slangi
/// @brief primary surface ReSTIR DI reservoir 生成、复用和最终 shade。

#pragma once

#include "lib/engine/core/random.slangi"
#include "lib/renderer/realtime_rt/raygen_direct_lighting.slangi"
#include "lib/renderer/realtime_rt/raygen_view.slangi"

static const uint RT_DEBUG_RESTIR_INITIAL_WEIGHT = 13;
static const uint RT_DEBUG_RESTIR_TEMPORAL_VALID = 14;
static const uint RT_DEBUG_RESTIR_FINAL_CONTRIBUTION = 15;
static const uint RESTIR_INITIAL_CANDIDATE_COUNT = 8;
static const float RESTIR_TEMPORAL_HISTORY_M_CAP = 64.0f;
static const int RESTIR_TEMPORAL_SEARCH_RADIUS_PX = 4;
static const uint RESTIR_SPATIAL_SAMPLE_COUNT = 8;
static const uint RESTIR_SPATIAL_DISOCCLUSION_BOOST_SAMPLE_COUNT = 16;
static const float RESTIR_SPATIAL_TARGET_HISTORY_LENGTH = 8.0f;

struct RtPrimarySurfaceKey
{
    // primary surface key 是 ReSTIR DI 自己的高精度 surface signature。
    // 它不是 RR/SR GBuffer 的别名；temporal rejection 和 final shade 都依赖这里的材质签名。
    float3 position;
    float linear_depth;
    float3 normal;
    /// visibility offset 必须使用几何法线，不能以 shading normal 替代。
    float3 origin_normal;
    float roughness;
    float3 base_color;
    float metallic;
    bool valid;

    static RtPrimarySurfaceKey empty()
    {
        RtPrimarySurfaceKey key;
        key.position = float3(0.0f);
        key.linear_depth = 0.0f;
        key.normal = float3(0.0f, 1.0f, 0.0f);
        key.origin_normal = key.normal;
        key.roughness = 0.0f;
        key.base_color = float3(0.0f);
        key.metallic = 0.0f;
        key.valid = false;
        return key;
    }
};

struct RtReservoir
{
    // reservoir 只保存 light-side sample identity。方向、距离、PDF、radiance 和 shadow ray
    // 都必须在当前 surface 上重建，避免把旧 shading point 的几何关系跨帧/跨邻域复用。
    RtLightSampleKey sample_key;
    /// 写入 storage image 时是 finalized inverse PDF；局部 streaming 时是普通 float raw sum。
    float weight_sum;

    /// 仅本轮使用的数值失败锁存；中间溢出后不能由后续候选重新激活。失败输出以 M=0 发布。
    bool failed;
    // target 是当前 reservoir 选中样本在“当前 phase 输出 surface”上的 target PDF。
    float target;

    /// M 是候选池规模，与是否选出正贡献 winner 无关；M=0 才表示没有可复用候选池。
    /// initial 完成采样后设为 1；temporal/spatial 累加，下一帧读取时再裁剪。
    float m;
    // source_age 表示 sample identity 从几帧前继承而来，只用于限制 stale history；
    // 它不是曝光、能量或采样 PDF 的一部分。
    float source_age;
    // valid 只表示存在可着色 winner；零估计候选池仍可有正 M。
    bool valid;
    uint sky_version;
    uint emissive_version;
    uint analytic_version;

    /// 零估计没有 sample identity，但已接受的候选池仍须参与后续 M 与校正分母。
    [mutating]
    void clear_sample()
    {
        sample_key = RtLightSampleKey::empty();
        weight_sum = 0.0f;
        target = 0.0f;
        source_age = 0.0f;
        valid = false;
    }

    [mutating]
    void invalidate()
    {
        clear_sample();
        m = 0.0f;
        failed = true;
    }

    static RtReservoir empty()
    {
        RtReservoir reservoir;
        reservoir.sample_key = RtLightSampleKey::empty();
        reservoir.weight_sum = 0.0f;
        reservoir.failed = false;
        reservoir.target = 0.0f;
        reservoir.m = 0.0f;
        reservoir.source_age = 0.0f;
        reservoir.valid = false;
        reservoir.sky_version = engine::binding::gpu_scene.sky_distribution_version;
        reservoir.emissive_version = engine::binding::gpu_scene.emissive_light_version;
        reservoir.analytic_version = engine::binding::gpu_scene.analytic_light_version;
        return reservoir;
    }
};

/// 同一个 light-side key 从 source 到 destination 的 dω_destination/dω_source。
/// 使用普通 float 比值；超出有限支持域由消费者丢弃该次 reservoir，不夹紧权重。
struct RtRestirJacobian
{
    float value;

    static RtRestirJacobian identity()
    {
        RtRestirJacobian result;
        result.value = 1.0f;
        return result;
    }

    static RtRestirJacobian between(const RtLightCandidate source, const RtLightCandidate destination)
    {
        RtRestirJacobian result = identity();
        if (!source.valid || !destination.valid || source.kind != destination.kind)
        {
            result.value = 0.0f;
            return result;
        }
        if (source.kind == RtLightCandidate::kind_hdri())
            return result;
        if (!isfinite(source.light_cos) || source.light_cos <= 0.0f ||
            !isfinite(destination.light_cos) || destination.light_cos <= 0.0f ||
            !isfinite(source.distance) || source.distance <= 0.0f ||
            !isfinite(destination.distance) || destination.distance <= 0.0f)
        {
            result.value = 0.0f;
            return result;
        }
        const float cosine_ratio = destination.light_cos / source.light_cos;
        const float distance_ratio = source.distance / destination.distance;
        result.value = cosine_ratio * distance_ratio * distance_ratio;
        return result;
    }
};

/// 本轮 bias correction 的分子或 piSum，不写入 reservoir storage。
struct RtRestirNormalization
{
    float sum;
    bool valid;

    static RtRestirNormalization empty()
    {
        RtRestirNormalization normalization;
        normalization.sum = 0.0f;
        normalization.valid = true;
        return normalization;
    }

    /// 一旦乘积或和越出 float 域，停止累加；调用方必须立即使输出 reservoir 失效。
    [mutating]
    void add(float target, float m, const RtRestirJacobian jacobian)
    {
        if (!isfinite(target) || target < 0.0f || !isfinite(m) || m < 0.0f)
            valid = false;
        if (!valid || target == 0.0f || m == 0.0f)
            return;
        if (!isfinite(jacobian.value) || jacobian.value <= 0.0f)
        {
            valid = false;
            return;
        }
        const float term = target * m * jacobian.value;
        const float next_sum = sum + term;
        if (!isfinite(term) || !isfinite(next_sum))
        {
            valid = false;
            return;
        }
        sum = next_sum;
    }
};

struct RtRestirDI
{
    static bool enabled()
    {
        return push_const.restir_di_mode != renderer::render_passes::realtime_rt::RESTIR_DI_MODE_OFF;
    }

    static bool temporal_enabled()
    {
        return push_const.restir_di_mode == renderer::render_passes::realtime_rt::RESTIR_DI_MODE_TEMPORAL ||
            push_const.restir_di_mode == renderer::render_passes::realtime_rt::RESTIR_DI_MODE_TEMPORAL_SPATIAL;
    }

    static bool spatial_enabled()
    {
        return push_const.restir_di_mode == renderer::render_passes::realtime_rt::RESTIR_DI_MODE_TEMPORAL_SPATIAL;
    }

    static bool is_restir_debug_channel()
    {
        return push_const.channel == RT_DEBUG_RESTIR_INITIAL_WEIGHT ||
            push_const.channel == RT_DEBUG_RESTIR_TEMPORAL_VALID ||
            push_const.channel == RT_DEBUG_RESTIR_FINAL_CONTRIBUTION;
    }

    static bool should_skip_primary_nee(uint depth, const RtSurfaceHit surface)
    {
        return enabled() && depth == 0 && is_primary_restir_surface(surface);
    }

    static bool is_primary_restir_surface(const RtSurfaceHit surface)
    {
        return surface.is_surface() &&
            !surface.is_delta_path() &&
            surface.material_type != MaterialType::EMISSIVE;
    }

    static void store_primary_surface_key(uint2 thread_id, const RtSurfaceHit surface)
    {
        // surface key 是 temporal/spatial reuse 的 eligibility 证明，而不仅是几何描述。
        // 只有 primary 直接光会被 ReSTIR 替换的表面才能写有效 key；delta / emissive / miss
        // 像素必须写空 key，避免旧 reservoir 被 final phase 加到不属于 ReSTIR DI 的路径上。
        store_surface_key(
            thread_id,
            is_primary_restir_surface(surface) ? surface_key_from_hit(surface) : RtPrimarySurfaceKey::empty()
        );
    }

    static uint4 pack_candidate_a(const RtReservoir reservoir)
    {
        /// A: winner identity metadata。A.w 与 D.w 均为零时仍可保存正 M 的零估计池；
        /// 是否有候选池由 C.z 决定，不能只看 winner 标记。
        return uint4(
            reservoir.sample_key.kind,
            reservoir.sample_key.light_index,
            reservoir.sample_key.class_mask,
            reservoir.valid ? 1u : 0u
        );
    }

    static float4 pack_candidate_b(const RtReservoir reservoir)
    {
        // B: light-side sample 参数。具体含义由 sample_key.kind 决定，不能解释为世界空间方向。
        return reservoir.sample_key.sample;
    }

    static float4 pack_candidate_c(const RtReservoir reservoir)
    {
        // C: reservoir 统计量。storage 中的 weight_sum 是 finalized inverse PDF；
        // target 与 M 必须和它一起传递，供后续 RTXDI-style combine / bias correction 使用。
        return float4(reservoir.weight_sum, reservoir.target, reservoir.m, reservoir.source_age);
    }

    static uint4 pack_candidate_d(const RtReservoir reservoir)
    {
        // D: scene 版本签名。只要 sky/emissive/analytic light 任一语义变化，旧 reservoir
        // 就不能参与复用；这比只靠 CPU reset 更细，能覆盖 scene 内容变化。
        return uint4(
            reservoir.sky_version,
            reservoir.emissive_version,
            reservoir.analytic_version,
            reservoir.sample_key.valid ? 1u : 0u
        );
    }

    static RtReservoir unpack_reservoir(uint4 a, float4 b, float4 c, uint4 d)
    {
        /// 保留正 M 的零估计池；非法统计或不一致的 winner/key 标记不能伪装成零估计。
        RtReservoir reservoir = RtReservoir::empty();
        reservoir.sample_key.kind = a.x;
        reservoir.sample_key.light_index = a.y;
        reservoir.sample_key.class_mask = a.z;
        reservoir.sample_key.valid = d.w != 0u;
        reservoir.sample_key.sample = b;
        reservoir.weight_sum = c.x;
        reservoir.target = c.y;
        reservoir.m = c.z;
        reservoir.source_age = c.w;
        reservoir.valid = a.w != 0u;
        reservoir.sky_version = d.x;
        reservoir.emissive_version = d.y;
        reservoir.analytic_version = d.z;
        if (!all(isfinite(b)) || !all(isfinite(c)) || reservoir.m <= 0.0f || reservoir.source_age < 0.0f ||
            (reservoir.valid
                ? !reservoir.sample_key.valid || a.x == 0u || reservoir.weight_sum <= 0.0f || reservoir.target <= 0.0f
                : reservoir.sample_key.valid || a.x != 0u || reservoir.weight_sum != 0.0f || reservoir.target != 0.0f))
        {
            return RtReservoir::empty();
        }
        return reservoir;
    }

    static void store_initial(uint2 thread_id, const RtReservoir reservoir)
    {
        renderer::render_passes::realtime_rt::restir_initial_a.Store(thread_id, pack_candidate_a(reservoir));
        renderer::render_passes::realtime_rt::restir_initial_b.Store(thread_id, pack_candidate_b(reservoir));
        renderer::render_passes::realtime_rt::restir_initial_c.Store(thread_id, pack_candidate_c(reservoir));
        renderer::render_passes::realtime_rt::restir_initial_d.Store(thread_id, pack_candidate_d(reservoir));
    }

    static RtReservoir load_initial(uint2 thread_id)
    {
        return unpack_reservoir(
            renderer::render_passes::realtime_rt::restir_initial_a.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_initial_b.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_initial_c.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_initial_d.Load(thread_id)
        );
    }

    static void store_temporal(uint2 thread_id, const RtReservoir reservoir)
    {
        renderer::render_passes::realtime_rt::restir_temporal_a.Store(thread_id, pack_candidate_a(reservoir));
        renderer::render_passes::realtime_rt::restir_temporal_b.Store(thread_id, pack_candidate_b(reservoir));
        renderer::render_passes::realtime_rt::restir_temporal_c.Store(thread_id, pack_candidate_c(reservoir));
        renderer::render_passes::realtime_rt::restir_temporal_d.Store(thread_id, pack_candidate_d(reservoir));
    }

    static RtReservoir load_temporal(uint2 thread_id)
    {
        return unpack_reservoir(
            renderer::render_passes::realtime_rt::restir_temporal_a.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_temporal_b.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_temporal_c.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_temporal_d.Load(thread_id)
        );
    }

    static void store_final(uint2 thread_id, const RtReservoir reservoir)
    {
        renderer::render_passes::realtime_rt::restir_final_a.Store(thread_id, pack_candidate_a(reservoir));
        renderer::render_passes::realtime_rt::restir_final_b.Store(thread_id, pack_candidate_b(reservoir));
        renderer::render_passes::realtime_rt::restir_final_c.Store(thread_id, pack_candidate_c(reservoir));
        renderer::render_passes::realtime_rt::restir_final_d.Store(thread_id, pack_candidate_d(reservoir));
    }

    static RtReservoir load_final(uint2 thread_id)
    {
        return unpack_reservoir(
            renderer::render_passes::realtime_rt::restir_final_a.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_final_b.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_final_c.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_final_d.Load(thread_id)
        );
    }

    static RtReservoir load_history(uint2 thread_id)
    {
        // history descriptor 由 Rust 侧绑定上一帧 temporal reservoir。
        // 这里的名字保持 shader 入口通用，但语义上绝不是上一帧 spatial/final reservoir。
        return unpack_reservoir(
            renderer::render_passes::realtime_rt::restir_history_a.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_history_b.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_history_c.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_history_d.Load(thread_id)
        );
    }

    static void store_surface_key(uint2 thread_id, const RtPrimarySurfaceKey key)
    {
        /// invalid key 必须清空四张图像；current/history 共用解包与有效性检查，
        /// 不能留下上一帧或上一 phase 的几何/材质签名。
        if (!key.valid)
        {
            renderer::render_passes::realtime_rt::restir_surface_a.Store(thread_id, float4(0.0f));
            renderer::render_passes::realtime_rt::restir_surface_b.Store(thread_id, float4(0.0f));
            renderer::render_passes::realtime_rt::restir_surface_c.Store(thread_id, float4(0.0f));
            renderer::render_passes::realtime_rt::restir_surface_d.Store(thread_id, float4(0.0f));
            return;
        }
        renderer::render_passes::realtime_rt::restir_surface_a.Store(thread_id, float4(key.position, key.linear_depth));
        renderer::render_passes::realtime_rt::restir_surface_b.Store(thread_id, float4(key.normal, key.roughness));
        renderer::render_passes::realtime_rt::restir_surface_c.Store(thread_id, float4(key.base_color, key.metallic));
        renderer::render_passes::realtime_rt::restir_surface_d.Store(thread_id, float4(key.origin_normal, 0.0f));
    }

    /// 先验证再归一化，空 key 不执行 normalize(0)，非法几何法线不能用着色法线兜底。
    static RtPrimarySurfaceKey unpack_surface_key(float4 a, float4 b, float4 c, float4 d)
    {
        RtPrimarySurfaceKey key = RtPrimarySurfaceKey::empty();
        const float normal_length_sq = dot(b.xyz, b.xyz);
        const float origin_length_sq = dot(d.xyz, d.xyz);
        if (!all(isfinite(a)) || !all(isfinite(b)) || !all(isfinite(c)) || !all(isfinite(d)) ||
            a.w <= 0.0f || !isfinite(normal_length_sq) || normal_length_sq <= 1e-5f ||
            !isfinite(origin_length_sq) || origin_length_sq <= 1e-5f)
        {
            return key;
        }
        key.position = a.xyz;
        key.linear_depth = a.w;
        key.normal = normalize(b.xyz);
        // traced hit 已提供单位几何法线，保留其原始 float 分量，避免再次归一化改变 offset 的 ULP 步长。
        key.origin_normal = d.xyz;
        key.roughness = b.w;
        key.base_color = c.xyz;
        key.metallic = c.w;
        key.valid = true;
        return key;
    }

    static RtPrimarySurfaceKey load_surface_key(uint2 thread_id)
    {
        return unpack_surface_key(
            renderer::render_passes::realtime_rt::restir_surface_a.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_surface_b.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_surface_c.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_surface_d.Load(thread_id)
        );
    }

    static RtPrimarySurfaceKey load_history_surface_key(uint2 thread_id)
    {
        /// 与 history reservoir 使用相同的重投影坐标和 previous frame label。
        return unpack_surface_key(
            renderer::render_passes::realtime_rt::restir_history_surface_a.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_history_surface_b.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_history_surface_c.Load(thread_id),
            renderer::render_passes::realtime_rt::restir_history_surface_d.Load(thread_id)
        );
    }

    static RtPrimarySurfaceKey surface_key_from_hit(const RtSurfaceHit surface)
    {
        RtPrimarySurfaceKey key;
        key.position = surface.position;
        key.linear_depth = surface.hit_t;
        key.normal = surface.forward_normal;
        key.origin_normal = surface.origin_normal;
        key.roughness = surface.roughness;
        key.base_color = surface.base_color;
        key.metallic = surface.metallic;
        key.valid = surface.is_surface();
        return key;
    }

    static RtSurfaceHit surface_from_key(const RtPrimarySurfaceKey primary_key)
    {
        RtSurfaceHit surface = {};
        // ReSTIR final shade 会重新发 visibility ray，起点/法线必须使用本 pass 自己的 RGBA32F
        // primary surface key。GBufferA/B/C 是 RR/SR 输入，位置、法线和材质可能被压缩，不适合作为
        // ReSTIR 时空复用后的真实重连表面或 target 函数签名。
        surface.position = primary_key.position;
        surface.object_position = float3(0.0f);
        surface.instance_id = 0;
        surface.geometry_id = 0;
        surface.primitive_id = 0;
        surface.forward_normal = primary_key.valid ? normalize(primary_key.normal) : float3(0.0f, 1.0f, 0.0f);
        surface.origin_normal = primary_key.valid ? primary_key.origin_normal : float3(0.0f, 1.0f, 0.0f);
        surface.object_normal = surface.forward_normal;
        surface.uv = float2(0.0f);
        surface.hit_t = primary_key.linear_depth;
        surface.base_color = primary_key.base_color;
        surface.metallic = primary_key.metallic;
        surface.roughness = primary_key.roughness;
        surface.opacity = 1.0f;
        surface.ior = 1.0f;
        surface.emissive = float3(0.0f);
        surface.material_type = primary_key.valid ? MaterialType::ROUGH_SURFACE : MaterialType::NO_HIT;
        return surface;
    }

    static RtSurfaceHit surface_from_restir_inputs(uint2 thread_id)
    {
        return surface_from_key(load_surface_key(thread_id));
    }

    static bool surface_compatible(const RtPrimarySurfaceKey current_key, const RtPrimarySurfaceKey history_key)
    {
        if (!current_key.valid || !history_key.valid)
        {
            return false;
        }
        if (dot(current_key.normal, history_key.normal) < 0.9f)
        {
            return false;
        }
        if (abs(current_key.roughness - history_key.roughness) > 0.15f)
        {
            return false;
        }
        if (abs(current_key.metallic - history_key.metallic) > 0.1f)
        {
            return false;
        }
        /// 材质相似性是本实现限制复用范围的启发式；不能代替在双方 surface 上重算 target。
        /// 跨材质复用并非天然非法，但放宽阈值需要单独验证校正支持域、方差与画面。
        const float3 base_color_delta = abs(current_key.base_color - history_key.base_color);
        if (max(base_color_delta.x, max(base_color_delta.y, base_color_delta.z)) > 0.18f)
        {
            return false;
        }
        /// linear_depth 是 primary ray 命中距离，单位为米；此阈值由 temporal/spatial 共用。
        /// 它比较两次实际距离，没有补偿相机平移；相同静态表面也可能被保守拒绝。
        /// absolute floor 仅防容差退化，不能当作 secondary ray 的 TMin 或 origin offset。
        const float depth_tolerance = max(0.0003f, current_key.linear_depth * 0.03f);
        if (abs(current_key.linear_depth - history_key.linear_depth) > depth_tolerance)
        {
            return false;
        }
        /// 0.0004m 是位置比较的米制 absolute floor；1% 是相对当前命中距离的复用阈值。
        /// 这些阈值不能当作几何表面偏移，否则会把兼容性调参耦合到 ray 数值契约。
        const float position_tolerance = max(0.0004f, current_key.linear_depth * 0.01f);
        return length(current_key.position - history_key.position) <= position_tolerance;
    }

    static bool reservoir_history_versions_match(const RtReservoir reservoir)
    {
        return reservoir.sky_version == engine::binding::gpu_scene.sky_distribution_version &&
            reservoir.emissive_version == engine::binding::gpu_scene.emissive_light_version &&
            reservoir.analytic_version == engine::binding::gpu_scene.analytic_light_version;
    }

    static bool reservoir_pool_reusable(const RtReservoir reservoir)
    {
        return !reservoir.failed && reservoir_history_versions_match(reservoir) &&
            isfinite(reservoir.weight_sum) && isfinite(reservoir.target) && isfinite(reservoir.m) && reservoir.m > 0.0f &&
            isfinite(reservoir.source_age) && reservoir.source_age >= 0.0f && reservoir.source_age <= 8.0f &&
            all(isfinite(reservoir.sample_key.sample)) &&
            (reservoir.valid
                ? RtDirectLighting::sample_key_matches_current_class_mask(reservoir.sample_key) &&
                    reservoir.sample_key.kind != 0u && reservoir.weight_sum > 0.0f && reservoir.target > 0.0f
                : !reservoir.sample_key.valid && reservoir.sample_key.kind == 0u && reservoir.weight_sum == 0.0f && reservoir.target == 0.0f);
    }

    static bool reservoir_reusable(const RtReservoir reservoir)
    {
        return reservoir.valid && reservoir_pool_reusable(reservoir);
    }

    static float visible_candidate_target(const RtLightCandidate candidate, const RtSurfaceHit surface, const float3 view_dir)
    {
        // 本实现固定使用 RTXDI RayTraced bias correction 风格：target PDF 评估包含一次保守 visibility。
        // 项目当前没有 previous TLAS，因此 temporal source surface 的校正 ray 仍走当前 TLAS；
        // 这比 1/M normalization 更接近 RTXDI，但动态几何上仍是一个有意的工程折中。
        if (!candidate.valid || !RtDirectLighting::is_candidate_visible(renderer::render_passes::realtime_rt::rt_tlas, candidate))
        {
            return 0.0f;
        }
        return RtDirectLighting::candidate_target(candidate, surface, view_dir);
    }

    static float target_at_surface(
        const RtLightSampleKey sample_key,
        const RtSurfaceHit surface,
        const float3 view_dir,
        out RtLightCandidate out_candidate
    )
    {
        out_candidate = RtDirectLighting::reconstruct_candidate_from_key(sample_key, surface);
        if (!out_candidate.valid)
        {
            return 0.0f;
        }
        return visible_candidate_target(out_candidate, surface, view_dir);
    }

    /// 普通 float streaming；数值失败锁存到本次输出，后续候选不得恢复它。
    static bool stream_weight(
        inout RtReservoir reservoir,
        const RtLightSampleKey sample_key,
        const float target_pdf,
        const float weight,
        const float source_age,
        inout uint random_seed
    )
    {
        if (reservoir.failed)
            return false;
        const float sum = reservoir.weight_sum + weight;
        if (!isfinite(weight) || weight < 0.0f || !isfinite(sum) || !isfinite(reservoir.m))
        {
            reservoir.invalidate();
            return false;
        }
        if (weight == 0.0f)
            return false;
        const bool selected = !reservoir.valid || Random::rnd(random_seed) * sum < weight;
        if (selected)
        {
            reservoir.sample_key = sample_key;
            reservoir.target = target_pdf;
            reservoir.source_age = source_age;
            reservoir.valid = true;
            reservoir.sky_version = engine::binding::gpu_scene.sky_distribution_version;
            reservoir.emissive_version = engine::binding::gpu_scene.emissive_light_version;
            reservoir.analytic_version = engine::binding::gpu_scene.analytic_light_version;
        }
        reservoir.weight_sum = sum;
        return selected;
    }

    /// 初始 proposal 权重为 target/pdf；正分母与输入有效域先于除法检查。
    static void stream_sample(
        inout RtReservoir reservoir,
        const RtLightSampleKey sample_key,
        const float target_pdf,
        const float source_pdf,
        inout uint random_seed
    )
    {
        if (reservoir.failed || !sample_key.valid || !all(isfinite(sample_key.sample)) ||
            !isfinite(target_pdf) || target_pdf <= 0.0f || !isfinite(source_pdf) || source_pdf <= 0.0f)
            return;
        reservoir.m += 1.0f;
        stream_weight(reservoir, sample_key, target_pdf, target_pdf / source_pdf, 0.0f, random_seed);
    }

    static bool combine_reservoirs(
        inout RtReservoir reservoir,
        const RtReservoir source,
        const float target_at_current,
        const RtRestirJacobian jacobian,
        inout uint random_seed
    )
    {
        if (reservoir.failed || !reservoir_pool_reusable(source))
            return false;
        // 零估计池参与 M，但不提供 winner，也不消耗竞争随机数。
        reservoir.m += source.m;
        if (!isfinite(reservoir.m))
        {
            reservoir.invalidate();
            return false;
        }
        if (!source.valid || !isfinite(target_at_current) || target_at_current <= 0.0f)
            return false;
        if (!isfinite(jacobian.value) || jacobian.value <= 0.0f)
        {
            reservoir.invalidate();
            return false;
        }
        const float weight = target_at_current * source.weight_sum * source.m * jacobian.value;
        return stream_weight(reservoir, source.sample_key, target_at_current, weight, source.source_age, random_seed);
    }

    static void finalize_resampling(
        inout RtReservoir reservoir,
        const float normalization_numerator,
        const float normalization_denominator
    )
    {
        if (reservoir.failed || !isfinite(reservoir.target) || reservoir.target < 0.0f ||
            !isfinite(reservoir.weight_sum) || reservoir.weight_sum < 0.0f ||
            !isfinite(reservoir.m) || reservoir.m <= 0.0f ||
            !isfinite(normalization_numerator) || normalization_numerator < 0.0f ||
            !isfinite(normalization_denominator) || normalization_denominator < 0.0f)
        {
            reservoir.invalidate();
            return;
        }
        if (!reservoir.valid || reservoir.target == 0.0f || reservoir.weight_sum == 0.0f ||
            normalization_numerator == 0.0f || normalization_denominator == 0.0f)
        {
            reservoir.clear_sample();
            return;
        }
        /// 保持 RTXDI rawSum * numerator / (selectedTarget * denominator)，不加分母 floor。
        const float numerator = reservoir.weight_sum * normalization_numerator;
        const float denominator = reservoir.target * normalization_denominator;
        if (!isfinite(numerator) || !isfinite(denominator) || denominator <= 0.0f)
        {
            reservoir.invalidate();
            return;
        }
        reservoir.weight_sum = numerator / denominator;
        if (!isfinite(reservoir.weight_sum) || reservoir.weight_sum <= 0.0f)
            reservoir.invalidate();
    }

    static void bias_correction_normalization(
        inout RtReservoir reservoir,
        const RtRestirNormalization numerator,
        const RtRestirNormalization normalization
    )
    {
        if (!numerator.valid || !normalization.valid)
        {
            reservoir.invalidate();
            return;
        }
        // source target 已转到当前立体角坐标；final shade 不再额外乘 Jacobian。
        finalize_resampling(reservoir, numerator.sum, normalization.sum);
    }

    static RtReservoir make_initial_reservoir(inout RtTracePayload payload, const RtSurfaceHit surface, const float3 view_dir)
    {
        RtReservoir reservoir = RtReservoir::empty();
        if (!is_primary_restir_surface(surface))
        {
            return reservoir;
        }

        // Initial reservoir 使用 RTXDI 的 streaming RIS 语义：proposal 以 target/pdf 进入 raw
        // weight sum，phase 结束时 finalize 成 inverse PDF，再把 M 设为 1 供 temporal combine。
        uint resampling_seed = payload.random_seed ^ 0x9E3779B9u;
        for (uint i = 0; i < RESTIR_INITIAL_CANDIDATE_COUNT; ++i)
        {
            const RtLightCandidate candidate = RtDirectLighting::sample_unified_candidate(payload, surface);
            const float target = visible_candidate_target(candidate, surface, view_dir);
            if (!candidate.valid || !candidate.sample_key.valid || target <= 0.0f || candidate.solid_angle_pdf <= 0.0f)
            {
                continue;
            }

            stream_sample(
                reservoir,
                candidate.sample_key,
                target,
                candidate.solid_angle_pdf,
                resampling_seed
            );
            if (reservoir.failed)
                return reservoir;
        }
        if (reservoir.valid)
        {
            // Initial denominator 使用固定 proposal 总数；finalized 后 M 按 RTXDI initial 输出契约设为 1。
            finalize_resampling(reservoir, 1.0f, (float)RESTIR_INITIAL_CANDIDATE_COUNT);
        }
        // 八次 proposal 即使全部为零也构成一个估计；不能条件化到“至少抽中一次”。
        if (!reservoir.failed)
            reservoir.m = 1.0f;
        return reservoir;
    }

    static uint make_resampling_seed(uint2 thread_id, uint salt)
    {
        return Random::tea(
            thread_id.y * DispatchRaysDimensions().x + thread_id.x,
            (uint)engine::binding::per_frame_data.frame_id * 1664525u + salt
        );
    }

    static RtReservoir capped_history_reservoir(const RtReservoir reservoir)
    {
        RtReservoir capped = reservoir;
        // weight_sum 已是 finalized inverse PDF；裁剪 history 时只裁剪 M，不再缩放 inverse PDF。
        capped.m = min(reservoir.m, RESTIR_TEMPORAL_HISTORY_M_CAP);
        return capped;
    }

    static int2 reproject_history_pixel(uint2 thread_id, const int2 offset)
    {
        /// MV 回溯无 jitter 投影的位置；数组索引还需扣除历史采样网格的 jitter。
        /// 差值来自已提交 reservoir 的 CPU 快照，不改变 DLSS 共用 MV 或邻域搜索策略。
        const float2 motion_vector = renderer::render_passes::realtime_rt::dlss_motion_vectors.Load(thread_id);
        return int2(floor(float2(thread_id) + motion_vector + push_const.restir_history_jitter_delta + float2(0.5f))) + offset;
    }

    static bool pixel_in_bounds(int2 pixel)
    {
        return pixel.x >= 0 && pixel.y >= 0 && pixel.x < int(DispatchRaysDimensions().x) && pixel.y < int(DispatchRaysDimensions().y);
    }

    static bool find_temporal_history_coord(
        uint2 thread_id,
        const RtPrimarySurfaceKey current_key,
        inout uint random_seed,
        out uint2 out_coord,
        out RtPrimarySurfaceKey out_key
    )
    {
        out_coord = uint2(0, 0);
        out_key = RtPrimarySurfaceKey::empty();
        for (uint i = 0; i < 9; ++i)
        {
            int2 offset = int2(0, 0);
            if (i > 0)
            {
                offset = int2(
                    int(floor(Random::rnd(random_seed) * float(RESTIR_TEMPORAL_SEARCH_RADIUS_PX * 2 + 1))) -
                        RESTIR_TEMPORAL_SEARCH_RADIUS_PX,
                    int(floor(Random::rnd(random_seed) * float(RESTIR_TEMPORAL_SEARCH_RADIUS_PX * 2 + 1))) -
                        RESTIR_TEMPORAL_SEARCH_RADIUS_PX
                );
            }

            const int2 history_pixel = reproject_history_pixel(thread_id, offset);
            if (!pixel_in_bounds(history_pixel))
            {
                continue;
            }

            const uint2 history_coord = uint2(history_pixel);
            const RtPrimarySurfaceKey history_key = load_history_surface_key(history_coord);
            if (!surface_compatible(current_key, history_key))
            {
                continue;
            }

            out_coord = history_coord;
            out_key = history_key;
            return true;
        }
        return false;
    }

    static int2 spatial_neighbor_offset(uint sample_index)
    {
        const int2 offsets[32] = {
            int2(1, 0),
            int2(-1, 0),
            int2(0, 1),
            int2(0, -1),
            int2(1, 1),
            int2(-1, 1),
            int2(1, -1),
            int2(-1, -1),
            int2(2, 0),
            int2(-2, 0),
            int2(0, 2),
            int2(0, -2),
            int2(2, 1),
            int2(-2, 1),
            int2(2, -1),
            int2(-2, -1),
            int2(1, 2),
            int2(-1, 2),
            int2(1, -2),
            int2(-1, -2),
            int2(3, 1),
            int2(-3, 1),
            int2(3, -1),
            int2(-3, -1),
            int2(1, 3),
            int2(-1, 3),
            int2(1, -3),
            int2(-1, -3),
            int2(3, 3),
            int2(-3, 3),
            int2(3, -3),
            int2(-3, -3)
        };
        return offsets[sample_index & 31u];
    }

    static RtReservoir temporal_resample(uint2 thread_id)
    {
        const RtSurfaceHit current_surface = surface_from_restir_inputs(thread_id);
        const RtPrimarySurfaceKey current_key = load_surface_key(thread_id);
        RtReservoir result = RtReservoir::empty();
        if (!current_surface.is_surface() || !current_key.valid)
        {
            return result;
        }

        uint random_seed = make_resampling_seed(thread_id, 19u);
        const RtReservoir initial = load_initial(thread_id);
        float initial_m = 0.0f;
        if (reservoir_pool_reusable(initial))
        {
            initial_m = initial.m;
            combine_reservoirs(result, initial, initial.target, RtRestirJacobian::identity(), random_seed);
        }

        bool selected_history = false;
        float history_m = 0.0f;
        RtPrimarySurfaceKey history_key = RtPrimarySurfaceKey::empty();
        if (push_const.restir_history_valid != 0 && current_key.valid)
        {
            uint2 history_coord;
            if (find_temporal_history_coord(thread_id, current_key, random_seed, history_coord, history_key))
            {
                RtReservoir history = capped_history_reservoir(load_history(history_coord));
                /// 接受、M 计数和校正必须使用同一个已推进年龄的 source 集合。
                /// 否则 age=8 先进入分母，递增后又被 combine 的 age<=8 检查拒绝。
                history.source_age = history.source_age + 1.0f;
                if (reservoir_pool_reusable(history))
                {
                    RtLightCandidate history_candidate;
                    const float history_target_at_current = history.valid
                        ? target_at_surface(history.sample_key, current_surface,
                            normalize(engine::binding::per_frame_data.camera_pos - current_surface.position), history_candidate) : 0.0f;
                    history_m = history.m;
                    RtRestirJacobian jacobian = RtRestirJacobian::identity();
                    if (history_target_at_current > 0.0f)
                    {
                        const RtLightCandidate source_candidate = RtDirectLighting::reconstruct_candidate_from_key(
                            history.sample_key, surface_from_key(history_key));
                        jacobian = RtRestirJacobian::between(source_candidate, history_candidate);
                    }
                    selected_history = combine_reservoirs(result, history, history_target_at_current, jacobian, random_seed);
                }
            }
        }

        if (result.failed)
            return result;
        if (result.valid)
        {
            const RtLightCandidate selected_at_current = RtDirectLighting::reconstruct_candidate_from_key(result.sample_key, current_surface);
            RtRestirNormalization numerator = RtRestirNormalization::empty();
            numerator.add(result.target, 1.0f, RtRestirJacobian::identity());
            if (!numerator.valid)
            {
                result.invalidate();
                return result;
            }
            RtRestirNormalization normalization = RtRestirNormalization::empty();
            normalization.add(result.target, initial_m, RtRestirJacobian::identity());
            if (!normalization.valid)
            {
                result.invalidate();
                return result;
            }
            if (history_m > 0.0f)
            {
                const RtSurfaceHit history_surface = surface_from_key(history_key);
                /// 历史 target 必须使用生成该来源的观察方向，包括 BRDF/MIS 的支持域。
                /// 当前 Camera 的 view 是刚体变换；用 R^T 把历史 view-space 的表面到相机向量转回世界空间。
                /// prev_view 对应上一实际提交主视图，不依赖当前相机位置，也不增加持久化字段。
                const float3 history_position_view = mul(engine::binding::per_frame_data.prev_view, float4(history_surface.position, 1.0f)).xyz;
                const float3 history_view_dir = normalize(mul(transpose(float3x3(engine::binding::per_frame_data.prev_view)), -history_position_view));
                RtLightCandidate selected_at_history;
                const float history_selected_target = target_at_surface(result.sample_key, history_surface, history_view_dir, selected_at_history);
                /// 校正把 source 的 target 乘 dω_source/dω_current，方向与竞争阶段相反。
                const RtRestirJacobian jacobian = history_selected_target > 0.0f
                    ? RtRestirJacobian::between(selected_at_current, selected_at_history) : RtRestirJacobian::identity();
                if (selected_history)
                {
                    numerator = RtRestirNormalization::empty();
                    numerator.add(history_selected_target, 1.0f, jacobian);
                    if (!numerator.valid)
                    {
                        result.invalidate();
                        return result;
                    }
                }
                normalization.add(history_selected_target, history_m, jacobian);
                if (!normalization.valid)
                {
                    result.invalidate();
                    return result;
                }
            }
            bias_correction_normalization(result, numerator, normalization);
        }
        return result;
    }

    static RtReservoir spatial_resample(uint2 thread_id)
    {
        const RtSurfaceHit current_surface = surface_from_restir_inputs(thread_id);
        const RtPrimarySurfaceKey current_key = load_surface_key(thread_id);
        RtReservoir result = RtReservoir::empty();
        if (!current_surface.is_surface() || !current_key.valid)
        {
            return result;
        }

        uint random_seed = make_resampling_seed(thread_id, 37u);
        const RtReservoir center = load_temporal(thread_id);
        float center_m = 0.0f;
        if (reservoir_pool_reusable(center))
        {
            center_m = center.m;
            combine_reservoirs(result, center, center.target, RtRestirJacobian::identity(), random_seed);
        }

        const uint spatial_sample_count = center_m < RESTIR_SPATIAL_TARGET_HISTORY_LENGTH
            ? RESTIR_SPATIAL_DISOCCLUSION_BOOST_SAMPLE_COUNT
            : RESTIR_SPATIAL_SAMPLE_COUNT;
        const uint start_index = min((uint)(Random::rnd(random_seed) * 32.0f), 31u);
        int selected_neighbor = -1;

        for (uint i = 0; i < spatial_sample_count; ++i)
        {
            const int2 sample_pixel = int2(thread_id) + spatial_neighbor_offset(start_index + i);
            if (!pixel_in_bounds(sample_pixel))
            {
                continue;
            }
            const uint2 sample_coord = uint2(sample_pixel);
            const RtPrimarySurfaceKey sample_key = load_surface_key(sample_coord);
            const RtReservoir sample_reservoir = load_temporal(sample_coord);
            if (!surface_compatible(current_key, sample_key) || !reservoir_pool_reusable(sample_reservoir))
            {
                continue;
            }

            // spatial reuse 只读取当前帧邻域 temporal reservoir，并按当前像素 surface 重算 target。
            // 它只用于当前帧 final reservoir，不能作为下一帧 temporal history。
            RtLightCandidate sample_candidate;
            const float sample_target = sample_reservoir.valid
                ? target_at_surface(sample_reservoir.sample_key, current_surface,
                    normalize(engine::binding::per_frame_data.camera_pos - current_surface.position), sample_candidate) : 0.0f;
            RtRestirJacobian jacobian = RtRestirJacobian::identity();
            if (sample_target > 0.0f)
            {
                const RtLightCandidate source_candidate = RtDirectLighting::reconstruct_candidate_from_key(
                    sample_reservoir.sample_key, surface_from_key(sample_key));
                jacobian = RtRestirJacobian::between(source_candidate, sample_candidate);
            }
            if (combine_reservoirs(result, sample_reservoir, sample_target, jacobian, random_seed))
            {
                selected_neighbor = int(i);
            }
            if (result.failed)
                return result;
        }

        if (result.failed)
            return result;
        if (result.valid)
        {
            const RtLightCandidate selected_at_current = RtDirectLighting::reconstruct_candidate_from_key(result.sample_key, current_surface);
            RtRestirNormalization numerator = RtRestirNormalization::empty();
            numerator.add(result.target, 1.0f, RtRestirJacobian::identity());
            if (!numerator.valid)
            {
                result.invalidate();
                return result;
            }
            RtRestirNormalization normalization = RtRestirNormalization::empty();
            normalization.add(result.target, center_m, RtRestirJacobian::identity());
            if (!normalization.valid)
            {
                result.invalidate();
                return result;
            }
            for (uint i = 0; i < spatial_sample_count; ++i)
            {
                const int2 sample_pixel = int2(thread_id) + spatial_neighbor_offset(start_index + i);
                if (!pixel_in_bounds(sample_pixel))
                {
                    continue;
                }
                const uint2 sample_coord = uint2(sample_pixel);
                const RtPrimarySurfaceKey sample_key = load_surface_key(sample_coord);
                const RtReservoir sample_reservoir = load_temporal(sample_coord);
                if (!surface_compatible(current_key, sample_key) || !reservoir_pool_reusable(sample_reservoir))
                {
                    continue;
                }

                const RtSurfaceHit sample_surface = surface_from_key(sample_key);
                RtLightCandidate selected_at_sample;
                const float sample_selected_target = target_at_surface(result.sample_key, sample_surface,
                    normalize(engine::binding::per_frame_data.camera_pos - sample_surface.position), selected_at_sample);
                const RtRestirJacobian jacobian = sample_selected_target > 0.0f
                    ? RtRestirJacobian::between(selected_at_current, selected_at_sample) : RtRestirJacobian::identity();
                if (selected_neighbor == int(i))
                {
                    numerator = RtRestirNormalization::empty();
                    numerator.add(sample_selected_target, 1.0f, jacobian);
                    if (!numerator.valid)
                    {
                        result.invalidate();
                        return result;
                    }
                }
                normalization.add(sample_selected_target, sample_reservoir.m, jacobian);
                if (!normalization.valid)
                {
                    result.invalidate();
                    return result;
                }
            }
            bias_correction_normalization(result, numerator, normalization);
        }

        return result;
    }

    static RtReservoir selected_final_reservoir(uint2 thread_id)
    {
        // final shade 根据 mode 选择当前帧最终估计器：InitialOnly 读 initial，Temporal 读 temporal，
        // TemporalSpatial 才读 final。这个选择不改变 Rust 侧 history 绑定仍然只用 temporal。
        if (push_const.restir_di_mode == renderer::render_passes::realtime_rt::RESTIR_DI_MODE_INITIAL_ONLY)
        {
            return load_initial(thread_id);
        }
        if (push_const.restir_di_mode == renderer::render_passes::realtime_rt::RESTIR_DI_MODE_TEMPORAL)
        {
            return load_temporal(thread_id);
        }
        return load_final(thread_id);
    }

    static float reservoir_shade_weight(const RtReservoir reservoir)
    {
        return reservoir.weight_sum;
    }

    static RtDirectLightingSample shade_final_reservoir(uint2 thread_id, const RtReservoir reservoir)
    {
        if (!reservoir_reusable(reservoir))
        {
            return RtDirectLightingSample::empty();
        }

        RtSurfaceHit surface = surface_from_restir_inputs(thread_id);
        const RtPrimarySurfaceKey current_key = load_surface_key(thread_id);
        if (!surface.is_surface() || !current_key.valid)
        {
            return RtDirectLightingSample::empty();
        }
        const RtLightCandidate candidate = RtDirectLighting::reconstruct_candidate_from_key(reservoir.sample_key, surface);
        // final shade 仍重新 trace visibility。temporal/spatial phase 已经排除过不可见候选，
        // 但最终输出必须以当前 TLAS 与当前 surface 为准，不能复用历史 visibility。
        if (!RtDirectLighting::is_candidate_visible(renderer::render_passes::realtime_rt::rt_tlas, candidate))
        {
            return RtDirectLightingSample::empty();
        }

        const float3 view_dir = normalize(engine::binding::per_frame_data.camera_pos - surface.position);
        return RtDirectLighting::shade_reservoir_candidate(
            candidate,
            surface,
            view_dir,
            reservoir_shade_weight(reservoir)
        );
    }

    static void run_temporal_phase(uint2 thread_id)
    {
        if (!temporal_enabled())
        {
            // 这是 helper 级防御分支：当前 Rust pass 在 InitialOnly 下不会执行 temporal phase，
            // 因此不能依赖这里刷新 temporal target。真正的 InitialOnly debug 语义在 final phase
            // 里显式处理，避免为了调试额外发起一次 TraceRays。
            store_temporal(thread_id, load_initial(thread_id));
            return;
        }
        store_temporal(thread_id, temporal_resample(thread_id));
    }

    static void run_spatial_phase(uint2 thread_id)
    {
        if (!spatial_enabled())
        {
            // Temporal 模式没有邻域复用；final target 保存 temporal 的当前帧副本，仅供 final/debug 读取。
            store_final(thread_id, load_temporal(thread_id));
            return;
        }
        store_final(thread_id, spatial_resample(thread_id));
    }

    static void run_final_phase(uint2 thread_id)
    {
        if (push_const.channel == RT_DEBUG_RESTIR_INITIAL_WEIGHT)
        {
            const RtReservoir initial = load_initial(thread_id);
            const float value = initial.valid ? saturate(log2(1.0f + initial.weight_sum) / 8.0f) : 0.0f;
            renderer::render_passes::realtime_rt::rt_single_frame_output.Store(thread_id, float4(float3(value), 1.0f));
            return;
        }
        if (push_const.channel == RT_DEBUG_RESTIR_TEMPORAL_VALID)
        {
            /// InitialOnly 不执行 temporal phase；不读取该 FIF 槽的旧内容。
            const RtReservoir temporal = temporal_enabled() ? load_temporal(thread_id) : RtReservoir::empty();
            const float valid_value = temporal.valid ? 1.0f : 0.0f;
            const float age_value = temporal.valid ? saturate(temporal.source_age / 8.0f) : 0.0f;
            renderer::render_passes::realtime_rt::rt_single_frame_output.Store(thread_id, float4(valid_value, 1.0f - age_value, age_value, 1.0f));
            return;
        }
        if (push_const.channel != 0 && push_const.channel != RT_DEBUG_RESTIR_FINAL_CONTRIBUTION)
        {
            /// surface/path debug 已在 path phase 写出；不覆盖图像，也不执行无人消费的 visibility/BRDF。
            return;
        }

        const RtReservoir reservoir = selected_final_reservoir(thread_id);
        const RtDirectLightingSample final_sample = shade_final_reservoir(thread_id, reservoir);
        if (push_const.channel == RT_DEBUG_RESTIR_FINAL_CONTRIBUTION)
        {
            renderer::render_passes::realtime_rt::rt_single_frame_output.Store(thread_id, float4(final_sample.contribution, 1.0f));
            return;
        }

        // 普通 Final 通道在 path phase 已经包含间接光、emission、sky 和 secondary NEE；
        // primary direct lighting 被 ReSTIR 接管后只在这里追加一次。
        const float3 base_radiance = renderer::render_passes::realtime_rt::rt_single_frame_output.Load(thread_id).xyz;
        renderer::render_passes::realtime_rt::rt_single_frame_output.Store(thread_id, float4(base_radiance + final_sample.contribution, 1.0f));
    }

    static void run_non_path_phase(uint2 thread_id)
    {
        // 非 path phase 不执行 camera ray/path loop，只处理 ReSTIR 的 image-space reuse 和 final shade。
        // phase 顺序由 Rust pass 用 image barrier 串联，shader 只根据 push constant 分派工作。
        if (push_const.restir_di_phase == renderer::render_passes::realtime_rt::RESTIR_DI_PHASE_TEMPORAL)
        {
            run_temporal_phase(thread_id);
        }
        else if (push_const.restir_di_phase == renderer::render_passes::realtime_rt::RESTIR_DI_PHASE_SPATIAL)
        {
            run_spatial_phase(thread_id);
        }
        else if (push_const.restir_di_phase == renderer::render_passes::realtime_rt::RESTIR_DI_PHASE_FINAL)
        {
            run_final_phase(thread_id);
        }
    }
};
