{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21
  },
  "configurePresets": [
    {
      "name": "native-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "inherits": "native-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/../build/cxx/cmake/vs2022",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/../build/cxx/output/vs2022/Debug",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/../build/cxx/output/vs2022/Debug",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/../build/cxx/output/vs2022/Debug",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/../build/cxx/output/vs2022/Release",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/../build/cxx/output/vs2022/Release",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/../build/cxx/output/vs2022/Release"
      }
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (x64)",
      "inherits": "native-base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/../build/cxx/cmake/vs2026",
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/../build/cxx/output/vs2026/Debug",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/../build/cxx/output/vs2026/Debug",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG": "${sourceDir}/../build/cxx/output/vs2026/Debug",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/../build/cxx/output/vs2026/Release",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/../build/cxx/output/vs2026/Release",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE": "${sourceDir}/../build/cxx/output/vs2026/Release"
      }
    },
    {
      "name": "clang-cl-base",
      "hidden": true,
      "inherits": "native-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe"
      }
    },
    {
      "name": "clang-cl-debug",
      "displayName": "Clang-CL Debug (x64)",
      "inherits": "clang-cl-base",
      "binaryDir": "${sourceDir}/../build/cxx/cmake/clang-cl/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/../build/cxx/output/clang-cl/Debug",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/../build/cxx/output/clang-cl/Debug",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/../build/cxx/output/clang-cl/Debug"
      }
    },
    {
      "name": "clang-cl-release",
      "displayName": "Clang-CL Release (x64)",
      "inherits": "clang-cl-base",
      "binaryDir": "${sourceDir}/../build/cxx/cmake/clang-cl/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/../build/cxx/output/clang-cl/Release",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/../build/cxx/output/clang-cl/Release",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/../build/cxx/output/clang-cl/Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022-build-debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-build-release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "vs2026-build-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-build-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "clang-cl-build-debug",
      "configurePreset": "clang-cl-debug"
    },
    {
      "name": "clang-cl-build-release",
      "configurePreset": "clang-cl-release"
    }
  ]
}
